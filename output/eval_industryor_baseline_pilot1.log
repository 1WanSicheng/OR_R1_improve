import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("WoodStorageAndTransportation")

# Define the quarters and related parameters
quarters = ["Winter", "Spring", "Summer", "Autumn"]
buying_prices = [410, 430, 460, 450]  # Buying prices (10,000 yuan/10,000 m²)
selling_prices = [425, 440, 465, 455]  # Selling prices (10,000 yuan/10,000 m²)
max_sales_volumes = [100, 140, 200, 160]  # Projected maximum sales volumes (10,000 m³)
storage_capacity = 200000  # Maximum wood storage capacity (10,000 m³)
a = 70  # Storage cost parameter a
b = 100  # Storage cost parameter b

# Add decision variables
x = [model.addVar(lb=0, name=f"x_{i}") for i in quarters]  # Amount of wood purchased in each quarter
y = [model.addVar(lb=0, name=f"y_{i}") for i in quarters]  # Amount of wood sold in each quarter
s = [model.addVar(lb=0, name=f"s_{i}") for i in quarters]  # Amount of wood stored in each quarter

# Set the objective function
model.setObjective(cp.quicksum(selling_prices[i] * y[i] - buying_prices[i] * x[i] - (a + b * (4 - i)) * s[i] for i in range(len(quarters))), sense=COPT.MAXIMIZE)

# Add constraints
# Wood storage capacity constraint
for i in range(len(quarters)):
    model.addConstr(s[i] <= storage_capacity, name=f"StorageCapacity_{i}")

# Wood sales volume constraint
for i in range(len(quarters)):
    model.addConstr(y[i] <= max_sales_volumes[i], name=f"MaxSalesVolume_{i}")

# Wood purchase and sales balance constraint
for i in range(len(quarters)):
