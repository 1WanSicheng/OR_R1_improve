model.addConstr(x_C >= 2*x_B - 5, name="ByproductCDisposalConstraint")  # Byproduct C disposal constraint

# Set the objective function
model.setObjective(4*x_A + 10*x_B + 3*x_C - 2*(2*x_B - x_C), sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
