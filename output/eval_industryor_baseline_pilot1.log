# The degree of satisfaction of the demands of Customer 1 and Customer 3 should be balanced as much as possible
model.addConstr(x_11 + x_21 + x_31 - x_13 - x_23 - x_33 <= 0, name="Balance1")
model.addConstr(x_11 + x_21 + x_31 - x_13 - x_23 - x_33 >= 0, name="Balance2")

# Solve the model
