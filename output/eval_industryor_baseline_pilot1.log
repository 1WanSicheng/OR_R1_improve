model.addConstr(6*x1 + 3*x2 + 5*x3 + 4*x4 <= 500, name="SteelConstraint")  # Steel material constraint
model.addConstr(x1 + x4 <= 1, name="TruckTrainConstraint")  # Manufacturing rule constraint 1
model.addConstr(x3 <= x2, name="BoatPlaneConstraint")  # Manufacturing rule constraint 2
model.addConstr(x3 <= x4, name="BoatTrainConstraint")  # Manufacturing rule constraint 3

# Set the objective function to maximize total profit
model.setObjective(5*x1 + 10*x2 + 8*x3 + 7*x4, sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
