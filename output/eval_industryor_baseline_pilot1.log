import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionPlanning")

# Define the demand forecast
demand_forecast = [20000, 40000, 42000, 35000, 19000, 18500]

# Define the parameters
raw_material_cost = 90
labor_hours_per_unit = 5
product_price = 300
initial_workers = 1000
initial_inventory = 15000
normal_wage = 30
overtime_wage = 40
working_days_per_month = 20
overtime_hours_per_worker_per_month = 20
inventory_cost = 15
stockout_cost = 35
outsourcing_cost = 200
hiring_cost = 5000
firing_cost = 8000

# Add decision variables
p = [model.addVar(lb=0, vtype=COPT.INTEGER, name=f"p_{t}") for t in range(6)]
h = [model.addVar(lb=0, vtype=COPT.INTEGER, name=f"h_{t}") for t in range(6)]
f = [model.addVar(lb=0, vtype=COPT.INTEGER, name=f"f_{t}") for t in range(6)]
i = [model.addVar(lb=0, vtype=COPT.INTEGER, name=f"i_{t}") for t in range(6)]
o = [model.addVar(lb=0, vtype=COPT.INTEGER, name=f"o_{t}") for t in range(6)]

# Set the objective function
model.setObjective(cp.quicksum((product_price * p[t] - raw_material_cost * p[t] - labor_hours_per_unit * normal_wage * p[t] / working_days_per_month - labor_hours_per_unit * overtime_wage * p[t] / working_days_per_month - inventory_cost * i[t] - stockout_cost * o[t] + outsourcing_cost * o[t]) for t in range(6)) - cp.quicksum((hiring_cost * h[t] + firing_cost * f[t]) for t in range(6)), sense=COPT.MAXIMIZE)

# Add constraints
# Demand satisfaction
for t in range(6):
    model.addConstr(p[t] + i[t-1] + o[t] >= demand_forecast[t], name=f"Demand_{t}")

# Inventory requirement
model.addConstr(i[5] >= 10000, name="InventoryRequirement")

# Inventory change
for t in range(6):
    if t == 0:
        model.addConstr(i[t] == p[t] - demand_forecast[t] - o[t], name=f"InventoryChange_{t}")
    else:
        model.addConstr(i[t] == i[t-1] + p[t] - demand_forecast[t] - o[t], name=f"InventoryChange_{t}")

# Worker constraints
for t in range(6):
    model.addConstr(h[t] + f[t] <= initial_workers + cp.quicksum(h[tt] - f[tt] for tt in range(t)), name=f"WorkerConstraint_{t}")

# Overtime constraints
for t in range(6):
    model.addConstr(labor_hours_per_unit * overtime_wage * p[t] / working_days_per_month <= overtime_hours_per_worker_per_month * initial_workers, name=f"OvertimeConstraint_{t}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total net profit: {:.2f}".format(model.objval))
    print("Production plan:")
    for t in range(6):
        print(f"Month {t+1}: {p[t].x} units")
    print("Worker schedule:")
    for t in range(6):
        print(f"Month {t+1}: Hire {h[t].x} workers, Fire {f[t].x} workers")
    print("Inventory plan:")
    for t in range(6):
        print(f"Month {t+1}: {i[t].x} units")
    print("Outsourcing plan:")
