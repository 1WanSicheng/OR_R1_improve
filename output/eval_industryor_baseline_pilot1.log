# Create decision variables
x = {(i, j): model.addVar(vtype=COPT.INTEGER, name=f"x_{i}_{j}") for i in students for j in days}

# Set the objective function
model.setObjective(cp.quicksum(wages[i-1] * x[i, j] for i in students for j in days), sense=COPT.MAXIMIZE)

# Add constraints
# Maximum duty time per day
for j in days:
    model.addConstr(cp.quicksum(x[i, j] for i in students) <= 3, name=f"MaxDutyPerDay_{j}")

# Maximum duty time per student per week
for i in students:
    model.addConstr(cp.quicksum(x[i, j] for j in days) <= max_hours[2*i-2:2*i], name=f"MaxDutyPerStudent_{i}")

# Minimum duty time per student per week
for i in students:
    if i <= 4:
        model.addConstr(cp.quicksum(x[i, j] for j in days) >= 8, name=f"MinDutyPerStudent_{i}")
    else:
        model.addConstr(cp.quicksum(x[i, j] for j in days) >= 7, name=f"MinDutyPerStudent_{i}")

# Maximum number of duty shifts per student per week
for i in students:
    model.addConstr(cp.quicksum(x[i, j] for j in days) <= 2 * max_hours[2*i-2:2*i], name=f"MaxShiftsPerStudent_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total remuneration: {:.2f} yuan".format(model.objval))
    for i in students:
        for j in days:
            if x[i, j].x > 0:
                print(f"Student {i} assigned {x[i, j].x} hours of duty on {j}")
else:
    print("No optimal solution found.")
```

