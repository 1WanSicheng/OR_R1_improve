```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionPlanning")

# Define the products
products = ['A1', 'A2', 'A3']

# Define the parameters
max_demand = {'A1': 5300, 'A2': 4500, 'A3': 5400}
selling_price = {'A1': 124, 'A2': 109, 'A3': 115}
production_cost = {'A1': 73.30, 'A2': 52.90, 'A3': 65.40}
production_quota = {'A1': 500, 'A2': 450, 'A3': 550}
activation_cost = {'A1': 170000, 'A2': 150000, 'A3': 100000}
min_batch_size = {'A1': 20, 'A2': 20, 'A3': 16}

# Add decision variables
x = {i: model.addVar(lb=0, vtype=COPT.INTEGER, name=f"x_{i}") for i in products}
y = {i: model.addVar(vtype=COPT.BINARY, name=f"y_{i}") for i in products}

# Set the objective function
model.setObjective(cp.quicksum((selling_price[i] - production_cost[i]) * x[i] - activation_cost[i] * y[i] for i in products), sense=COPT.MAXIMIZE)

# Add constraints
# Production quota constraints
for i in products:
    model.addConstr(x[i] <= production_quota[i] * y[i], name=f"ProductionQuota_{i}")

# Minimum production batch size constraints
for i in products:
    model.addConstr(x[i] >= min_batch_size[i] * y[i], name=f"MinBatchSize_{i}")

# Total production time constraint
model.addConstr(cp.quicksum(x[i] for i in products) <= 22 * cp.quicksum(y[i] for i in products), name="TotalProductionTime")

# Maximum demand constraints
for i in products:
    model.addConstr(x[i] <= max_demand[i], name=f"MaxDemand_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total revenue: ${:.2f}".format(model.objval))
    for i in products:
        print(f"Production quantity of product {i}: {x[i].x} units")
        print(f"Activation status of production line for product {i}: {'Activated' if y[i].x == 1 else 'Not activated'}")
else:
    print("No optimal solution found.")
```

