import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionPlanning")

# Define the products and quarters
products = ['I', 'II', 'III']
quarters = [1, 2, 3, 4]

# Define the contract booking numbers
demand = {
    ('I', 1): 1500, ('I', 2): 1000, ('I', 3): 2000, ('I', 4): 1200,
    ('II', 1): 1500, ('II', 2): 1500, ('II', 3): 1200, ('II', 4): 1500,
    ('III', 1): 1000, ('III', 2): 2000, ('III', 3): 1500, ('III', 4): 2500
}

# Define the production time
production_time = {'I': 2, 'II': 4, 'III': 3}

# Define the compensation and storage costs
compensation = {'I': 20, 'II': 20, 'III': 10}
storage = {'I': 5, 'II': 5, 'III': 5}

# Add decision variables
p = {(i, t): model.addVar(vtype=COPT.INTEGER, name=f"p_{i}_{t}") for i in products for t in quarters}
s = {(i, t): model.addVar(vtype=COPT.INTEGER, name=f"s_{i}_{t}") for i in products for t in quarters}

# Set the objective function
model.setObjective(cp.quicksum(compensation[i] * (p[i, t] - demand[i, t]) + storage[i] * s[i, t] for i in products for t in quarters), sense=COPT.MINIMIZE)

# Add constraints
# Contract booking numbers
for i in products:
    for t in quarters:
        model.addConstr(p[i, t] + s[i, t] == demand[i, t], name=f"Demand_{i}_{t}")

# Production time constraints
for t in quarters:
    model.addConstr(cp.quicksum(production_time[i] * p[i, t] for i in products) <= 15000, name=f"ProductionTime_{t}")

# Inventory requirements
for i in products:
    model.addConstr(s[i, 4] == 150, name=f"Inventory_{i}")

# Production constraints
