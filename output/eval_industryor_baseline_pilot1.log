```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionPlanning")

# Add decision variables
x1 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x1")  # Number of microwaves produced per month
x2 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x2")  # Number of water heaters produced per month

# Add constraints
model.addConstr(30*x1 + 50*x2 <= 4500, name="InspectionAndSalesCost")  # Inspection and sales costs should not exceed $4500 per month
model.addConstr(x1 >= 80, name="MicrowaveSales")  # Sell no less than 80 microwaves per month
model.addConstr(x2 >= 50, name="WaterHeaterSales")  # Sell no less than 50 water heaters per month
model.addConstr(2*x1 + x2 <= 120, name="WorkshopAProduction")  # Workshop A production hours should not exceed 120 hours per month
model.addConstr(x1 + 3*x2 <= 150, name="WorkshopBProduction")  # Workshop B production hours should not exceed 150 hours per month
model.addConstr(2*x1 + x2 <= 140, name="WorkshopAOvertime")  # Workshop A overtime should not exceed 20 hours per month

# Set the objective function
model.setObjective(80*(2*x1 + x2) + 20*(x1 + 3*x2) + 30*x1 + 50*x2, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.2f}".format(model.objval))
    print("Optimal production plan:")
    print("Number of microwaves produced per month: {}".format(x1.x))
    print("Number of water heaters produced per month: {}".format(x2.x))
else:
    print("No optimal solution found.")
```

