    print("Maximized total profit: ${:.2f}".format(model.objval))
    print("Optimal production and sales plan:")
    print(f"Number of units of product A produced: {x_A.x}")
    print(f"Number of units of product B produced: {x_B.x}")
    print(f"Number of units of byproduct C sold: {x_C.x}")
else:
    print("No optimal solution found.")
