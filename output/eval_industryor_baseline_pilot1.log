import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("PaperMillOptimization")

# Define the data
widths = [0.5, 0.7, 0.9]  # Widths of the orders
lengths = [1000, 3000, 2000]  # Lengths of the orders
standard_widths = [1, 2]  # Standard widths of the rolls

# Add decision variables
x = {}
