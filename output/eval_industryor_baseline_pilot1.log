    ('I', 1): 5, ('I', 2): 5, ('I', 3): 5, ('I', 4): 5, ('I', 5): 5,
    ('I', 6): 4.5, ('I', 7): 4.5, ('I', 8): 4.5, ('I', 9): 4.5, ('I', 10): 4.5,
    ('I', 11): 4.5, ('I', 12): 4.5,
    ('II', 1): 8, ('II', 2): 8, ('II', 3): 8, ('II', 4): 8, ('II', 5): 8,
    ('II', 6): 7, ('II', 7): 7, ('II', 8): 7, ('II', 9): 7, ('II', 10): 7,
    ('II', 11): 7, ('II', 12): 7
}

# Define the storage costs
storage_costs = {
    ('I', 1): 1, ('I', 2): 1, ('I', 3): 1, ('I', 4): 1, ('I', 5): 1,
    ('I', 6): 1, ('I', 7): 1, ('I', 8): 1, ('I', 9): 1, ('I', 10): 1,
    ('I', 11): 1, ('I', 12): 1,
    ('II', 1): 1, ('II', 2): 1, ('II', 3): 1, ('II', 4): 1, ('II', 5): 1,
    ('II', 6): 1, ('II', 7): 1, ('II', 8): 1, ('II', 9): 1, ('II', 10): 1,
    ('II', 11): 1, ('II', 12): 1
}

# Add decision variables
x = {(i, t): model.addVar(vtype=COPT.INTEGER, name=f"x_{i}_{t}") for i in products for t in months}
s = {(i, t): model.addVar(vtype=COPT.INTEGER, name=f"s_{i}_{t}") for i in products for t in months}

# Set the objective function
