x_24 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_24")
x_31 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_31")
x_32 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_32")
x_33 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_33")
x_34 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_34")

# Set the objective function
model.setObjective(5*x_11 + 2*x_12 + 6*x_13 + 7*x_14 + 3*x_21 + 5*x_22 + 4*x_23 + 10*x_24 + 4*x_31 + 3*x_32 + 2*x_33 + 13*x_34, sense=COPT.MINIMIZE)

# Add constraints
# Supply capacity of the factories
model.addConstr(x_11 + x_12 + x_13 + x_14 <= 30, name="Supply1")
model.addConstr(x_21 + x_22 + x_23 + x_24 <= 20, name="Supply2")
model.addConstr(x_31 + x_32 + x_33 + x_34 <= 100, name="Supply3")

# Demand of the customers
model.addConstr(x_11 + x_21 + x_31 >= 20, name="Demand1")
model.addConstr(x_12 + x_22 + x_32 >= 10, name="Demand2")
model.addConstr(x_13 + x_23 + x_33 >= 45, name="Demand3")
model.addConstr(x_14 + x_24 + x_34 >= 25, name="Demand4")

# Order quantity of Customer 4 must be fully satisfied
model.addConstr(x_14 + x_24 + x_34 == 25, name="Demand4_Full")

# The degree of satisfaction of the order quantity for the remaining customers should not be less than 80%
model.addConstr(x_11 + x_21 + x_31 >= 0.8 * 20, name="Demand1_80%")
model.addConstr(x_12 + x_22 + x_32 >= 0.8 * 10, name="Demand2_80%")
model.addConstr(x_13 + x_23 + x_33 >= 0.8 * 45, name="Demand3_80%")

