```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("MicrocomputerProduction")

# Add decision variables
x_A = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_A")  # Number of units of model A produced per week
x_B = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_B")  # Number of units of model B produced per week
x_A_overtime = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_A_overtime")  # Number of units of model A produced during overtime in process II per week
x_B_overtime = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_B_overtime")  # Number of units of model B produced during overtime in process II per week

# Set the objective function
model.setObjective(300*x_A + 450*x_B - 20*x_A_overtime - 25*x_B_overtime, sense=COPT.MAXIMIZE)

# Add constraints
model.addConstr(4*x_A + 6*x_B <= 150, name="ProcessI_Capacity")  # Process I processing capacity constraint
model.addConstr(3*x_A + 2*x_B + x_A_overtime + x_B_overtime <= 70 + 30, name="ProcessII_Capacity")  # Process II processing capacity constraint
model.addConstr(300*x_A + 450*x_B - 20*x_A_overtime - 25*x_B_overtime >= 10000, name="TotalProfit")  # Total profit constraint
model.addConstr(x_A >= 10, name="ModelA_Min")  # Model A production quantity constraint
model.addConstr(x_B >= 15, name="ModelB_Min")  # Model B production quantity constraint
model.addConstr(x_A_overtime + x_B_overtime <= 30, name="ProcessII_Overtime")  # Process II overtime production quantity constraint

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f} RMB".format(model.objval))
    print("Number of units of model A produced per week: {}".format(x_A.x))
    print("Number of units of model B produced per week: {}".format(x_B.x))
    print("Number of units of model A produced during overtime in process II per week: {}".format(x_A_overtime.x))
    print("Number of units of model B produced during overtime in process II per week: {}".format(x_B_overtime.x))
else:
    print("No optimal solution found.")
```

This script first creates a COPT environment and model. Then, it adds four decision variables: `x_A`, `x_B`, `x_A_overtime`, and `x_B_overtime`, representing the number of units of model A and model B produced per week and during overtime in process II, respectively.

Next, the script sets the objective function, which is to maximize the total profit. It then adds all the constraints, including the processing capacity constraints for process I and process II, the total profit constraint, the minimum production quantity constraints for model A and model B, and the maximum overtime production quantity constraint for process II.

