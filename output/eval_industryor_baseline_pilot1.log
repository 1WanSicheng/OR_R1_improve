    ('II', 'red'): model.addVar(lb=0, name="x_II_red"),
    ('II', 'yellow'): model.addVar(lb=0, name="x_II_yellow"),
    ('II', 'blue'): model.addVar(lb=0, name="x_II_blue")
}

# Define the objective function
model.setObjective((5.5 - 6) * x[('I', 'red')] + (5.5 - 4.5) * x[('I', 'red')] +
                   (5.5 - 3) * x[('II', 'red')] + (5.0 - 6) * x[('I', 'yellow')] +
                   (5.0 - 4.5) * x[('I', 'yellow')] + (5.0 - 3) * x[('II', 'yellow')] +
                   (4.8 - 6) * x[('I', 'blue')] + (4.8 - 4.5) * x[('I', 'blue')] +
                   (4.8 - 3) * x[('II', 'blue')], sense=COPT.MAXIMIZE)

# Add constraints
# Blending ratio constraints
model.addConstr(x[('I', 'red')] < 0.1 * (x[('I', 'red')] + x[('II', 'red')]), name="Red_I_ratio")
model.addConstr(x[('I', 'red')] > 0.5 * (x[('I', 'red')] + x[('II', 'red')]), name="Red_I_ratio2")
model.addConstr(x[('II', 'yellow')] < 0.7 * (x[('I', 'yellow')] + x[('II', 'yellow')]), name="Yellow_II_ratio")
model.addConstr(x[('I', 'yellow')] > 0.2 * (x[('I', 'yellow')] + x[('II', 'yellow')]), name="Yellow_I_ratio")
model.addConstr(x[('I', 'blue')] < 0.5 * (x[('I', 'blue')] + x[('II', 'blue')]), name="Blue_I_ratio")
model.addConstr(x[('I', 'blue')] > 0.1 * (x[('I', 'blue')] + x[('II', 'blue')]), name="Blue_I_ratio2")

# Daily supply constraints
model.addConstr(x[('I', 'red')] + x[('I', 'yellow')] + x[('I', 'blue')] <= 1500 + 2000, name="Supply_I")
model.addConstr(x[('II', 'red')] + x[('II', 'yellow')] + x[('II', 'blue')] <= 1000, name="Supply_II")

# Minimum production requirement for the red brand
model.addConstr(x[('I', 'red')] + x[('II', 'red')] >= 2000, name="Min_red_production")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit: {:.2f} yuan".format(model.objval))
    print("Optimal blending strategy:")
    for key, var in x.items():
        print(f"Amount of wine grade {key[0]} used to produce brand {key[1]}: {var.x:.2f} kg")
else:
    print("No optimal solution found.")
```

This script first creates a COPT environment and model. Then, it defines the decision variables `x`, representing the amount of wine of each grade used to produce each brand.

Next, the script sets the objective function, which is to maximize profit. It calculates the total profit based on the selling price, cost, and amount of each brand of wine.

Then, the script adds constraints, including the blending ratio constraints, daily supply constraints, and the minimum production requirement for the red brand.

Finally, the script solves the model and outputs the maximized profit and the optimal blending strategy (if an optimal solution is found).

Note that this script assumes you have installed the `coptpy` library and have a valid COPT license. If you haven't installed it yet, you may need to install the library first before running this script.
