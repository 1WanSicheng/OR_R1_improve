```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("WaitstaffScheduling")

# Define the start times of the shifts
shift_start_times = ["2am", "6am", "10am", "2pm", "6pm", "10pm"]

# Define the minimum number of waitstaff requirements for each time period
min_staff_requirements = {
    "2am-6am": 4,
    "6am-10am": 8,
    "10am-2pm": 10,
    "2pm-6pm": 4,
    "6pm-10pm": 8,
    "10pm-2am": 4
}

# Add decision variables
