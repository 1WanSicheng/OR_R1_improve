# Add constraints
for period, requirement in min_staff_requirements.items():
    model.addConstr(cp.quicksum(x[i] for i in shift_start_times if period in [f"{i}-{i+4}am" if i == "2am" else f"{i}-{i+4}pm" for i in shift_start_times]), lb=requirement, name=f"MinStaff_{period}")

# Set the objective function
model.setObjective(cp.quicksum(x[i] for i in shift_start_times), sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum number of waitstaff: {}".format(model.objval))
    for i in shift_start_times:
        print(f"Number of waitstaff starting work at {i}: {x[i].x}")
else:
