model.setObjective(10 * cp.quicksum(x[i] * 8 for i in range(len(time_periods))) +
                   15 * cp.quicksum(y[i] * 8 for i in range(len(time_periods))),
                   sense=COPT.MINIMIZE)

# Add constraints
