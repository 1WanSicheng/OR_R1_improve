import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("DutyAssignment")

# Define the data
students = [1, 2, 3, 4, 5, 6]
days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
wages = [10.0, 10.0, 9.9, 9.8, 10.8, 11.3]
