model.addConstr(x['G'] + durations['G'] <= x['F'], name="Duration_G_F")
model.addConstr(x['D'] + durations['D'] <= x['C'], name="Duration_D_C")
model.addConstr(x['F'] + durations['F'] <= x['B'], name="Duration_F_B")
model.addConstr(x['C'] + durations['C'] <= x['D'], name="Duration_C_D")

# Set the objective function
model.setObjective(1000 * (x['G'] - x['A'] + 1) + 5000 * (x['B'] - x['A'] + 1), sense=COPT.MINIMIZE)

