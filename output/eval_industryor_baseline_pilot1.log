```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ContainerLoadingOptimization")

# Define the data
goods_types = ['A', 'B', 'C', 'D', 'E']
container_weight_limit = 60
container_volume_limit = 15.5 * 2.8 * 2.8
min_container_weight = 18
goods_weights = {'A': 0.5, 'B': 1, 'C': 0.4, 'D': 0.6, 'E': 0.65}
goods_volumes = {'A': 0.65 * 1 * 1, 'B': 0.2 * 2 * 2, 'C': 0.35 * 2 * 1, 'D': 0.2 * 3 * 1, 'E': 0.15 * 5 * 1}
goods_inventory = {'A': 120, 'B': 90, 'C': 300, 'D': 90, 'E': 120}

# Add decision variables
x = {(i, j): model.addVar(vtype=COPT.INTEGER, name=f"x_{i}_{j}") for i in range(1, 100) for j in goods_types}
y = {i: model.addVar(vtype=COPT.BINARY, name=f"y_{i}") for i in range(1, 100)}

# Set the objective function
model.setObjective(cp.quicksum(y[i] for i in range(1, 100)), sense=COPT.MINIMIZE)

# Add constraints
# Weight constraint
for i in range(1, 100):
    model.addConstr(cp.quicksum(goods_weights[j] * x[i, j] for j in goods_types) <= container_weight_limit * y[i], name=f"WeightConstraint_{i}")

# Volume constraint
for i in range(1, 100):
    model.addConstr(cp.quicksum(goods_volumes[j] * x[i, j] for j in goods_types) <= container_volume_limit * y[i], name=f"VolumeConstraint_{i}")

# Minimum weight constraint
for i in range(1, 100):
    model.addConstr(cp.quicksum(goods_weights[j] * x[i, j] for j in goods_types) >= min_container_weight * y[i], name=f"MinWeightConstraint_{i}")

# Specific packaging requirements
for i in range(1, 100):
    model.addConstr(x[i, 'A'] <= x[i, 'C'], name=f"SpecificPackagingConstraint_{i}_A_C")
    model.addConstr(x[i, 'C'] >= 12 * y[i], name=f"SpecificPackagingConstraint_{i}_C")

# Inventory limitations
for j in goods_types:
    model.addConstr(cp.quicksum(x[i, j] for i in range(1, 100)) <= goods_inventory[j], name=f"InventoryConstraint_{j}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum number of containers: {}".format(model.objval))
    for i in range(1, 100):
        if y[i].x > 0.5:
            print(f"Container {i}:")
            for j in goods_types:
                if x[i, j].x > 0:
                    print(f"  Goods {j}: {x[i, j].x} units")
else:
    print("No optimal solution found.")
```

