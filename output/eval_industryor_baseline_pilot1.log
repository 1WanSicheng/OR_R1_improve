import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionPlanning")

# Define the data
products = [1, 2, 3, 4, 5]
months = [1, 2, 3, 4, 5, 6]
D = [1000, 2000, 1500, 2500, 3000]  # Order quantities
S = [100, 120, 110, 130, 140]  # Unit selling prices
C = [50, 60, 40, 70, 80]  # Unit costs
a = [10, 20, 15, 25, 30]  # Production hours required per unit
C_prime = [55, 65, 45, 75, 85]  # Unit overtime costs
p3 = 100  # Penalty cost for product 3
p4 = 150  # Penalty cost for product 4

# Add decision variables
x = {(i, j): model.addVar(vtype=COPT.INTEGER, name=f"x_{i}_{j}") for i in products for j in months}

# Objective function: Maximize total profit
model.setObjective(cp.quicksum((S[i-1] - C[i-1]) * x[i, j] for i in products for j in months) +
                   cp.quicksum((S[i-1] - C_prime[i-1]) * x[i, j] for i in products for j in months), sense=COPT.MAXIMIZE)

# Constraints
# Production hours constraints
for j in months:
    model.addConstr(cp.quicksum(a[i-1] * x[i, j] for i in products) <=
                    (12000 if j == 1 else 11000 if j == 2 else 13000 if j == 3 else 13500 if j == 4 else 13500 if j == 5 else 14000) +
                    (3000 if j == 1 else 2500 if j == 2 else 3300 if j == 3 else 3500 if j == 4 else 3500 if j == 5 else 3800), name=f"ProductionHours_{j}")

# Delivery requirements
for i in products:
    for j in months:
        if i == 1 and j < 3:
            model.addConstr(x[i, j] == 0, name=f"DeliveryRequirement_{i}_{j}")
        elif i == 3 and j > 4:
            model.addConstr(x[i, j] == 0, name=f"DeliveryRequirement_{i}_{j}")
        elif i == 4 and j < 2 or j > 5:
            model.addConstr(x[i, j] == 0, name=f"DeliveryRequirement_{i}_{j}")

# Penalty costs
for i in products:
    for j in months:
        if i == 3 and j > 4:
            model.addConstr(x[i, j] <= D[i-1] - p3 * (j - 4), name=f"PenaltyCost_{i}_{j}")
        elif i == 4 and j > 5:
            model.addConstr(x[i, j] <= D[i-1] - p4 * (j - 5), name=f"PenaltyCost_{i}_{j}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f}".format(model.objval))
    for i in products:
        for j in months:
            if x[i, j].x > 0:
                print(f"Quantity of product {i} produced in month {j}: {x[i, j].x}")
else:
    print("No optimal solution found.")
```

