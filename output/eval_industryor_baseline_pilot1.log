    model.addConstr(x[i] + y[i] >= nurse_requirements[i], name=f"Demand_{time_periods[i]}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.2f}".format(model.objval))
    for i in range(len(time_periods)):
        print(f"Number of regular nurses hired at {time_periods[i]}: {x[i].x}")
        print(f"Number of contract nurses hired at {time_periods[i]}: {y[i].x}")
else:
    print("No optimal solution found.")
