model.setObjective(cp.quicksum(route_costs[j] * x[i][j] for i in range(num_drivers) for j in range(num_routes)), sense=COPT.MINIMIZE)

# Add constraints
# Each sales location receives its order
for j in range(num_routes):
    model.addConstr(cp.quicksum(x[i][j] for i in range(num_drivers)) == 1, name=f"Order_{j}")

# Each delivery person can transport up to max_orders_per_driver types of orders
for i in range(num_drivers):
    model.addConstr(cp.quicksum(x[i][j] for j in range(num_routes)) <= max_orders_per_driver, name=f"Driver_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {}".format(model.objval))
