import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionOptimization")

# Workshop production capacity
production_capacity = {'A': 100, 'B': 150, 'C': 80, 'D': 200}

# Component productivity
productivity = {
