# Joint capacity constraints
for i in Cities:
    for j in Cities:
        model.addConstr(cp.quicksum(x[i, j, p] for p in Products) <= JointCapacity[i][j], name=f"JointCapacity_{i}_{j}")

# Individual capacity constraints
for i in Cities:
    for j in Cities:
