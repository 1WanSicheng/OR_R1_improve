```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionOptimization")

# Define the data
gadgets = ['G1', 'G2', 'G3', 'G4', 'G5']
revenue = {'G1': 50, 'G2': 60, 'G3': 70, 'G4': 80, 'G5': 90}
production_time = {'G1': 2, 'G2': 3, 'G3': 4, 'G4': 5, 'G5': 6}
material_cost = {'G1': 20, 'G2': 25, 'G3': 30, 'G4': 35, 'G5': 40}

# Add decision variables
x = {i: model.addVar(lb=0, vtype=COPT.INTEGER, name=f"x_{i}") for i in gadgets}

# Set the objective function
model.setObjective(cp.quicksum((revenue[i] - material_cost[i]) / production_time[i] * x[i] for i in gadgets), sense=COPT.MAXIMIZE)

# Add constraints
# Production time constraint
model.addConstr(cp.quicksum(production_time[i] * x[i] for i in gadgets) <= 100, name="ProductionTimeConstraint")

# Material cost constraint
model.addConstr(cp.quicksum(material_cost[i] * x[i] for i in gadgets) <= 5000, name="MaterialCostConstraint")

# Market demand constraint
model.addConstr(cp.quicksum(x[i] for i in gadgets) >= 40, name="MarketDemandConstraint")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit efficiency: {:.2f}".format(model.objval))
    print("Optimal production quantities:")
    for i in gadgets:
        print(f"Gadget {i}: {x[i].x} units")
else:
    print("No optimal solution found.")
```

