```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FlooringCompanyOptimization")

# Add decision variables
x = model.addVar(lb=0, name="x")  # Number of square feet of laminate planks produced weekly
y = model.addVar(lb=0, name="y")  # Number of square feet of carpets produced weekly

# Add constraints
model.addConstr(x >= 15000, name="LaminateDemand")  # Laminate plank demand constraint
model.addConstr(y >= 5000, name="CarpetDemand")  # Carpet demand constraint
model.addConstr(x + y >= 50000, name="TotalProduction")  # Total production constraint
model.addConstr(x <= 40000, name="LaminateCapacity")  # Laminate plank production capacity constraint
model.addConstr(y <= 20000, name="CarpetCapacity")  # Carpet production capacity constraint

# Set the objective function to maximize profit
model.setObjective(2.1*x + 3.3*y, sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit: {:.2f} dollars".format(model.objval))
    print("Optimal production quantities:")
    print("Laminate planks: {:.2f} square feet".format(x.x))
    print("Carpets: {:.2f} square feet".format(y.x))
else:
    print("No optimal solution found.")
```

