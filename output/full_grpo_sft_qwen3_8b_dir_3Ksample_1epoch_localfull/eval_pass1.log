import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionOptimization")

# Add decision variables
x1 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x1")  # Number of units of product 1 produced
x2 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x2")  # Number of units of product 2 produced
