model.addConstr(x_Y + x_W >= 60, name="ServiceBalanceYW")

# Set the objective function
model.setObjective(0.2*x_X + 0.3*x_Y + 0.1*x_Z + 0.4*x_W, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.0f}".format(model.objval))
    print("Optimal resource allocation:")
