    [3, 3, 5, 4],
    [3, 5, 2, 4],
    [2, 4, 5, 1]
]
demands = [859, 713, 421, 652]
supply_capacities = [1547, 1656, 1274, 1882]

# Add decision variables
y = [model.addVar(vtype=COPT.BINARY, name=f"y_{i}") for i in range(num_centers)]
x = [[model.addVar(lb=0, name=f"x_{i}_{j}") for j in range(num_outlets)] for i in range(num_centers)]

# Objective function: Minimize total cost
model.setObjective(cp.quicksum(opening_costs[i] * y[i] for i in range(num_centers)) +
                   cp.quicksum(transport_costs[i][j] * x[i][j] for i in range(num_centers) for j in range(num_outlets)),
                   sense=COPT.MINIMIZE)

# Constraints
# Meet the demand at each retail outlet
for j in range(num_outlets):
    model.addConstr(cp.quicksum(x[i][j] for i in range(num_centers)) == demands[j], name=f"Demand_{j}")

# Do not exceed the supply capacity of each distribution center
for i in range(num_centers):
    model.addConstr(cp.quicksum(x[i][j] for j in range(num_outlets)) <= supply_capacities[i] * y[i], name=f"Supply_{i}")

# Solve the model
model.solve()

