## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FactoryProductionOptimization")

# Define equipment and products
equipment = ['A1', 'A2', 'B1', 'B2', 'B3']
products = ['I', 'II', 'III']

# Define equipment available time and cost
available_time = {'A1': 10000, 'A2': 4000, 'B1': 7000, 'B2': 4000, 'B3': 0}
cost = {'A1': 321, 'A2': 250, 'B1': 783, 'B2': 200, 'B3': 0}

# Define unit processing time
processing_time = {
    'A1': {'I': 5, 'II': 10, 'III': 0},
    'A2': {'I': 7, 'II': 9, 'III': 12},
    'B1': {'I': 6, 'II': 8, 'III': 0},
    'B2': {'I': 4, 'II': 0, 'III': 11},
    'B3': {'I': 7, 'II': 0, 'III': 0}
}

# Define unit price and raw material cost
unit_price = {'I': 1.25, 'II': 2.00, 'III': 2.80}
material_cost = {'I': 0.25, 'II': 0.35, 'III': 0.50}

# Add decision variables
x = {(i, j): model.addVar(vtype=COPT.INTEGER, name=f"x_{i}_{j}") for i in equipment for j in products if processing_time[i][j] > 0}

# Set the objective function
model.setObjective(cp.quicksum((unit_price[j] - material_cost[j] - processing_time[i][j] * 0.1) * x[(i, j)] for i in equipment for j in products if processing_time[i][j] > 0) -
                   cp.quicksum(cost[i] * cp.quicksum(x[(i, j)] for j in products if processing_time[i][j] > 0) / available_time[i] for i in equipment), sense=COPT.MAXIMIZE)

# Add constraints
for i in equipment:
    model.addConstr(cp.quicksum(x[(i, j)] for j in products if processing_time[i][j] > 0) <= available_time[i], name=f"AvailableTime_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit: {:.2f} CNY".format(model.objval))
    print("Optimal production plan:")
    for i in equipment:
        for j in products:
            if processing_time[i][j] > 0 and x[(i, j)].x > 0:
                print(f"Quantity of product {j} processed on equipment {i}: {x[(i, j)].x}")
else:
    print("No optimal solution found.")
```

