```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ParkConstructionOptimization")

# Define the data
neighborhoods = ['A', 'B', 'C', 'D', 'E']
costs = {'A': 50000, 'B': 70000, 'C': 60000, 'D': 80000, 'E': 90000}
benefits = {'A': 100, 'B': 150, 'C': 120, 'D': 180, 'E': 200}
budget = 1000000
max_parks = 15

# Add decision variables
x = {i: model.addVar(vtype=COPT.INTEGER, name=f"x_{i}") for i in neighborhoods}

# Objective function: Maximize the benefit-to-cost ratio
objective = cp.quicksum((benefits[i] / costs[i]) * x[i] for i in neighborhoods)
model.setObjective(objective, sense=COPT.MAXIMIZE)

# Constraints
# Budget constraint
model.addConstr(cp.quicksum(costs[i] * x[i] for i in neighborhoods) <= budget, name="BudgetConstraint")

# Total number of parks constraint
model.addConstr(cp.quicksum(x[i] for i in neighborhoods) <= max_parks, name="TotalParksConstraint")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized benefit-to-cost ratio: {:.2f}".format(model.objval))
    print("Optimal park construction plan:")
    for i in neighborhoods:
        print(f"Neighborhood {i}: {x[i].x} parks")
else:
    print("No optimal solution found.")
```

