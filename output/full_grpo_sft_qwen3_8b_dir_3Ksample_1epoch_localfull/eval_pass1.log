```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("BakeryProductionOptimization")

# Oven production rates
oven_rates = {
    1: {'cake1': 15, 'cake2': 20},
    2: {'cake1': 20, 'cake2': 25},
    3: {'cake1': 25, 'cake2': 30},
    4: {'cake1': 30, 'cake2': 35},
    5: {'cake1': 35, 'cake2': 40}
}

# Demand for cakes
demand = {'cake1': 200, 'cake2': 300}

# Number of workers
num_workers = 40
max_workers_per_oven = 15

# Add decision variables
x = {i: model.addVar(lb=0, vtype=COPT.CONTINUOUS, name=f"x_{i}") for i in oven_rates}
t1 = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="t1")
t2 = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="t2")

# Objective function: Minimize the production time
model.setObjective(t1, sense=COPT.MINIMIZE)

# Constraints
# Demand for cake 1
model.addConstr(cp.quicksum(oven_rates[i]['cake1'] * x[i] for i in oven_rates) >= demand['cake1'], name="DemandCake1")

# Demand for cake 2
model.addConstr(cp.quicksum(oven_rates[i]['cake2'] * x[i] for i in oven_rates) >= demand['cake2'], name="DemandCake2")

# Worker constraints
model.addConstr(cp.quicksum(x[i] for i in oven_rates) <= num_workers, name="TotalWorkers")
for i in oven_rates:
    model.addConstr(x[i] <= max_workers_per_oven, name=f"MaxWorkers_{i}")

# Production time constraints
model.addConstr(t1 >= demand['cake1'] / cp.quicksum(oven_rates[i]['cake1'] * x[i] for i in oven_rates), name="TimeCake1")
model.addConstr(t2 >= demand['cake2'] / cp.quicksum(oven_rates[i]['cake2'] * x[i] for i in oven_rates), name="TimeCake2")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum production time: {:.2f} hours".format(model.objval))
    print("Number of workers assigned to each oven:")
    for i in oven_rates:
        print(f"Oven {i}: {x[i].x:.2f} workers")
else:
    print("No optimal solution found.")
```

This script first defines the oven production rates, cake demand, and worker constraints. Then, it creates decision variables, including the number of workers assigned to each oven and the production time for each type of cake.

The objective function is to minimize the production time, which is the maximum of the production times required for each type of cake. The constraints include meeting the demand for each type of cake, not exceeding the total number of workers, and not exceeding the maximum number of workers per oven.

Finally, the script solves the model and outputs the minimum production time and the number of workers assigned to each oven.

Note that this script uses the `cp.quicksum` function to simplify the summation of variables. If you are using an older version of the `coptpy` library, you may need to replace `cp.quicksum` with a regular `sum` function.
