model.addConstr(x - y >= 300, name="MinimumGapConstraint")  # Minimum gap constraint
model.addConstr(2*x + y <= 2000, name="StorageConstraint")  # Storage constraint

# Set the objective function to minimize the total production cost
model.setObjective(50*x + 75*y, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total production cost: ${:.0f}".format(model.objval))
    print("Optimal production quantities:")
    print("Product X: {:.0f} units".format(x.x))
    print("Product Y: {:.0f} units".format(y.x))
else:
    print("No optimal solution found.")
```

