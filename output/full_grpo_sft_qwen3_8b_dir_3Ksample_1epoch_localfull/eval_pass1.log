env = cp.Envr()

# Create a model
model = env.createModel("ProductionPlanning")

# Define parameters
num_months = 6
initial_workers = 1000
initial_inventory = 15000
material_cost = 90
labor_hours = 5
product_price = 300
normal_wage = 30
overtime_wage = 40
normal_hours = 8
overtime_hours = 20
inventory_cost = 15
stockout_cost = 35
outsourcing_cost = 200
hiring_cost = 5000
firing_cost = 8000

# Define demand forecast
demand_forecast = [20000, 40000, 42000, 35000, 19000, 18500]

# Add decision variables
p = [model.addVar(lb=0, name=f"p_{t}") for t in range(num_months)]
h = [model.addVar(lb=0, name=f"h_{t}") for t in range(num_months)]
f = [model.addVar(lb=0, name=f"f_{t}") for t in range(num_months)]
i = [model.addVar(lb=0, name=f"i_{t}") for t in range(num_months)]
o = [model.addVar(lb=0, name=f"o_{t}") for t in range(num_months)]

# Set the objective function
model.setObjective(cp.quicksum((product_price * p[t] - material_cost * p[t] - 
                               labor_hours * normal_wage * normal_hours * p[t] / initial_workers - 
                               labor_hours * normal_wage * normal_hours * p[t] / initial_workers * overtime_hours / 20 - 
                               inventory_cost * i[t] - stockout_cost * o[t]) for t in range(num_months)) - 
                   cp.quicksum(hiring_cost * h[t] + firing_cost * f[t] for t in range(num_months)), 
                   sense=COPT.MAXIMIZE)

# Add constraints
