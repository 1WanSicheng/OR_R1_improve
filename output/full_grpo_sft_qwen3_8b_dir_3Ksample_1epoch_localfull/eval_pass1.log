import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("MealPlanOptimization")

# Food items and their nutritional information
foods = {
    'Chicken': {'protein': 18, 'carbohydrate': 23, 'calorie': 217, 'price': 3},
