model.addConstr(1.00*x1 + 1.20*x2 <= 40, name="VeneeringTimeConstraint")  # Veneering time constraint
model.addConstr(90*x1 + 100*x2 <= 2000, name="OakConstraint")  # Oak resource constraint
model.addConstr(50*x1 + 60*x2 <= 1500, name="PecanConstraint")  # Pecan veneer resource constraint
model.addConstr(x1 <= 20, name="ClassicSalesConstraint")  # Classic dresser sales constraint
model.addConstr(x2 <= 25, name="ModernSalesConstraint")  # Modern dresser sales constraint

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized contribution to overhead: {:.2f}".format(model.objval))
    print("Optimal production quantities:")
    print("Classic dressers: {:.0f}".format(x1.x))
    print("Modern dressers: {:.0f}".format(x2.x))
else:
    print("No optimal solution found.")
```

