```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("SalesmanTour")

# Define the cities
cities = ['A', 'B', 'C', 'D']

# Define the travel costs
costs = {
    'A': {'B': 19, 'C': 45, 'D': 30},
    'B': {'A': 19, 'C': 89, 'D': 46},
    'C': {'A': 45, 'B': 89, 'D': 11},
    'D': {'A': 30, 'B': 46, 'C': 11}
}

# Add decision variables
x = {(i, j): model.addVar(vtype=COPT.BINARY, name=f"x_{i}_{j}") for i in cities for j in cities if i != j}

# Objective function: Minimize total travel cost
model.setObjective(cp.quicksum(costs[i][j] * x[(i, j)] for i in cities for j in cities if i != j), sense=COPT.MINIMIZE)

# Constraints
# Each city is visited exactly once
for i in cities:
    model.addConstr(cp.quicksum(x[(i, j)] for j in cities if i != j) == 1, name=f"Departure_{i}")

# Each city is left exactly once
for j in cities:
    model.addConstr(cp.quicksum(x[(i, j)] for i in cities if i != j) == 1, name=f"Arrival_{j}")

# No sub-tours (using MTZ constraints)
u = {i: model.addVar(lb=1, ub=len(cities), vtype=COPT.INTEGER, name=f"u_{i}") for i in cities}

for i in cities:
    for j in cities:
        if i != j:
            model.addConstr(u[i] - u[j] + len(cities) * x[(i, j)] <= len(cities) - 1, name=f"MTZ_{i}_{j}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total travel cost: {:.2f}".format(model.objval))
    print("Optimal route:")
    route = []
    current_city = cities[0]
    while len(route) < len(cities):
        for j in cities:
            if current_city != j and x[(current_city, j)].x > 0.5:
                route.append(current_city)
                current_city = j
                break
    route.append(current_city)
    print(" -> ".join(route))
else:
    print("No optimal solution found.")
```

This script first defines the cities and travel costs, then creates the decision variables `x` to represent whether the salesperson travels from city `i` to city `j`. The objective function is to minimize the total travel cost, and the constraints ensure that each city is visited exactly once and no sub-tours are formed.

The script uses the Miller-Tucker-Zemlin (MTZ) constraints to handle the sub-tour problem. It introduces an additional variable `u` for each city to represent the order in which the city is visited. The MTZ constraints ensure that the solution does not contain any sub-tours.

Finally, the script solves the model and outputs the minimum total travel cost and the optimal route. If an optimal solution is found, it prints the route; otherwise, it indicates that no optimal solution was found.

