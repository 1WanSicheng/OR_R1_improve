    print("Maximum amount of goods transported from the distribution hub to the final destination: {:.2f} thousand kilograms".format(model.objval))
    print("Optimal flow:")
    for i in cities:
        for j in cities:
            if i != j and (i, j) in f and f[(i, j)].x > 0:
                print(f"From City {i} to City {j}: {f[(i, j)].x:.2f} thousand kilograms")
else:
    print("No optimal solution found.")
```

