# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total number of ski lifts: {:.0f}".format(model.objval))
    print("Number of densely-seated ski lifts: {:.0f}".format(x.x))
    print("Number of loosely-seated ski lifts: {:.0f}".format(y.x))
else:
    print("No optimal solution found.")
```

