```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("FarmOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Area planted with crop X
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Area planted with crop Y

# Add constraints
model.addConstr(x + y <= 50, name="LandConstraint")  # Land area constraint
model.addConstr(x >= 2*y, name="MarketDemandConstraint")  # Market demand constraint
model.addConstr(x - 2*y <= 10, name="AreaDifferenceConstraint")  # Area difference constraint
model.addConstr(x + y >= 40, name="TotalAreaConstraint")  # Total area constraint

# Set the objective function
model.setObjective(5*x + 10*y, sense=COPT.MINIMIZE)  # Minimize total cost

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.0f}".format(model.objval))
    print("Optimal planting areas:")
    print("Crop X: {:.0f} acres".format(x.x))
    print("Crop Y: {:.0f} acres".format(y.x))
else:
    print("No optimal solution found.")
```

