    model.addConstr(cp.quicksum(f[(i, j)] for j in cities if (i, j) in capacity) == 
                    cp.quicksum(f[(j, i)] for j in cities if (j, i) in capacity), name=f"FlowBalance_{i}")

# Capacity constraints of each highway
