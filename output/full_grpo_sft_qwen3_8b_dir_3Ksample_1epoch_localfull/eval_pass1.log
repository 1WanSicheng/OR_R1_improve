import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("NutritionOptimization")

# Food items and their nutritional information and costs
foods = {
    'Chicken': {'protein': 5, 'carbohydrate': 15, 'calorie': 162, 'cost': 8},
    'Rice': {'protein': 8, 'carbohydrate': 17, 'calorie': 282, 'cost': 4},
    'Eggs': {'protein': 18, 'carbohydrate': 20, 'calorie': 234, 'cost': 1},
    'Beans': {'protein': 16, 'carbohydrate': 15, 'calorie': 85, 'cost': 4},
    'Spinach': {'protein': 3, 'carbohydrate': 28, 'calorie': 194, 'cost': 7},
    'Corn': {'protein': 3, 'carbohydrate': 19, 'calorie': 153, 'cost': 2},
    'Beef': {'protein': 6, 'carbohydrate': 24, 'calorie': 167, 'cost': 9},
    'Broccoli': {'protein': 17, 'carbohydrate': 9, 'calorie': 192, 'cost': 3}
}

# Nutritional requirements
protein_requirement = 68
carbohydrate_requirement = 189
calorie_requirement = 1840

# Add decision variables
x = {food: model.addVar(lb=0, name=f"x_{food}") for food in foods}

# Objective function: Minimize total cost
model.setObjective(cp.quicksum(foods[food]['cost'] * x[food] for food in foods), sense=COPT.MINIMIZE)

# Constraints
# Protein requirement
model.addConstr(cp.quicksum(foods[food]['protein'] * x[food] for food in foods) >= protein_requirement, name="ProteinRequirement")

# Carbohydrate requirement
model.addConstr(cp.quicksum(foods[food]['carbohydrate'] * x[food] for food in foods) >= carbohydrate_requirement, name="CarbohydrateRequirement")

# Calorie requirement
model.addConstr(cp.quicksum(foods[food]['calorie'] * x[food] for food in foods) >= calorie_requirement, name="CalorieRequirement")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.2f}".format(model.objval))
    print("Optimal food quantities:")
    for food in foods:
        print(f"{food}: {x[food].x:.2f}")
else:
    print("No optimal solution found.")
```

