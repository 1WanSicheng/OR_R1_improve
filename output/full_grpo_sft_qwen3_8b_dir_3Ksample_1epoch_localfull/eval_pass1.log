import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("RocketOptimization")

# Given data
m = 2140  # Mass of the rocket (kg)
H = 23000  # Target height (m)
T = 60  # Total time (s)
b = 10000  # Maximum force (N)
n = 20  # Number of time intervals
g = 9.8  # Gravitational acceleration (m/s²)
dt = T / n  # Time interval length (s)

# Add decision variables
u = [model.addVar(lb=0, ub=b, name=f"u_{k}") for k in range(n)]

# Add constraints
y = [0] * (n + 1)
y[0] = 0  # Initial height
for k in range(n):
    y[k+1] = y[k] + u[k] / m * dt - 0.5 * g * dt**2
    model.addConstr(y[k+1] <= H, name=f"HeightConstraint_{k}")

# Set the objective function
model.setObjective(cp.quicksum(u[k] for k in range(n)), sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total energy consumption: {:.2f} N·s".format(model.objval))
    print("Optimal force at each time interval:")
    for k in range(n):
        print(f"Time interval {k+1}: {u[k].x:.2f} N")
else:
