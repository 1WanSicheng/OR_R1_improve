    print("Minimum total compensation and storage costs: {:.2f}".format(model.objval))
    for i in products:
        for t in quarters:
            print(f"Production quantity of product {i} in quarter {t}: {p[i, t].x:.2f}")
            print(f"Storage quantity of product {i} in quarter {t}: {s[i, t].x:.2f}")
else:
    print("No optimal solution found.")
```

