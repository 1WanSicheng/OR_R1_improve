```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("TruckOptimization")

# Truck types
truck_types = ['A', 'B', 'C', 'D', 'E']

# Fuel cost per kilometer
fuel_cost = {'A': 2, 'B': 3, 'C': 4, 'D': 5, 'E': 6}

# Maintenance cost per month
