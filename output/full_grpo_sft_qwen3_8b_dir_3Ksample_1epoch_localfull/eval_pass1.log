## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("DietPlan")

# Food items and their nutritional values and costs
foods = {
    'Steak': {'protein': 14, 'carbohydrate': 23, 'calorie': 63, 'cost': 4},
    'Tofu': {'protein': 2, 'carbohydrate': 13, 'calorie': 162, 'cost': 6},
    'Chicken': {'protein': 17, 'carbohydrate': 13, 'calorie': 260, 'cost': 6},
    'Broccoli': {'protein': 3, 'carbohydrate': 1, 'calorie': 55, 'cost': 8},
    'Rice': {'protein': 15, 'carbohydrate': 23, 'calorie': 231, 'cost': 8},
    'Spinach': {'protein': 2, 'carbohydrate': 8, 'calorie': 297, 'cost': 5}
}

# Add decision variables
x = {food: model.addVar(lb=0, name=f"x_{food}") for food in foods}

# Objective function: Minimize total cost
model.setObjective(cp.quicksum(foods[food]['cost'] * x[food] for food in foods), sense=COPT.MINIMIZE)

# Constraints
# Protein requirement
model.addConstr(cp.quicksum(foods[food]['protein'] * x[food] for food in foods) >= 83, name="ProteinRequirement")

# Carbohydrate requirement
model.addConstr(cp.quicksum(foods[food]['carbohydrate'] * x[food] for food in foods) >= 192, name="CarbohydrateRequirement")

# Calorie requirement
model.addConstr(cp.quicksum(foods[food]['calorie'] * x[food] for food in foods) >= 2089, name="CalorieRequirement")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum cost: {:.2f}".format(model.objval))
    print("Optimal meal plan:")
    for food in foods:
        if x[food].x > 0:
            print(f"{food}: {x[food].x:.2f} units")
else:
    print("No optimal solution found.")
```

