```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("TransportationOptimization")

# Define the data
cargos = ['Electronics', 'Textiles', 'Food']
transport_cost = {'Electronics': 100, 'Textiles': 80, 'Food': 120}
revenue = {'Electronics': 200, 'Textiles': 160, 'Food': 240}
max_trips_per_vehicle = {'Electronics': 5, 'Textiles': 6, 'Food': 4}

# Add decision variables
x = {i: model.addVar(lb=0, vtype=COPT.INTEGER, name=f"x_{i}") for i in cargos}
y = {i: model.addVar(lb=0, vtype=COPT.INTEGER, name=f"y_{i}") for i in cargos}

# Set the objective function
model.setObjective(cp.quicksum((revenue[i] - transport_cost[i]) * x[i] * y[i] for i in cargos), sense=COPT.MAXIMIZE)

# Add constraints
# Total number of vehicles constraint
model.addConstr(cp.quicksum(x[i] for i in cargos) <= 20, name="TotalVehicles")

# Budget constraint
model.addConstr(cp.quicksum(transport_cost[i] * x[i] * y[i] for i in cargos) <= 1500, name="Budget")

# Operational capacity constraint
model.addConstr(cp.quicksum(x[i] * y[i] for i in cargos) <= 100, name="OperationalCapacity")

# Maximum number of trips per vehicle constraint
for i in cargos:
    model.addConstr(y[i] <= max_trips_per_vehicle[i], name=f"MaxTrips_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f}".format(model.objval))
    for i in cargos:
        print(f"Number of vehicles allocated for {i}: {x[i].x}")
        print(f"Number of trips per vehicle for {i}: {y[i].x}")
else:
    print("No optimal solution found.")
```

