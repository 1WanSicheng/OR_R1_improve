import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("XuriProductionPlanning")

# Define parameters
products = [1, 2, 3, 4, 5]
months = [1, 2, 3, 4, 5, 6]
D = {1: 1000, 2: 1500, 3: 2000, 4: 1800, 5: 1200}  # Order quantities
S = {1: 100, 2: 120, 3: 150, 4: 130, 5: 110}  # Unit selling prices
C = {1: 80, 2: 90, 3: 120, 4: 100, 5: 95}  # Unit costs
a = {1: 2, 2: 3, 3: 4, 4: 3, 5: 2}  # Production hours required per unit
C_prime = {1: 10, 2: 15, 3: 20, 4: 18, 5: 12}  # Overtime cost per unit
p3 = 50  # Delay penalty for product 3
p4 = 60  # Delay penalty for product 4

# Define decision variables
x = {(i, t): model.addVar(lb=0, name=f"x_{i}_{t}") for i in products for t in months}

# Objective function: Maximize total profit
model.setObjective(cp.quicksum((S[i] - C[i]) * x[(i, t)] for i in products for t in months) -
                   cp.quicksum(C_prime[i] * x[(i, t)] for i in products for t in months), sense=COPT.MAXIMIZE)

# Constraints
# Production hours constraints
for t in months:
    model.addConstr(cp.quicksum(a[i] * x[(i, t)] for i in products) <=
                    (12000 if t == 1 else 11000 if t == 2 else 13000 if t == 3 else 13500 if t == 4 else 13500 if t == 5 else 14000) +
                    (3000 if t == 1 else 2500 if t == 2 else 3300 if t == 3 else 3500 if t == 4 else 3500 if t == 5 else 3800),
                    name=f"ProductionHours_{t}")

# Delivery requirements
model.addConstr(cp.quicksum(x[(1, t)] for t in months[2:]) == D[1], name="Delivery1")
model.addConstr(cp.quicksum(x[(3, t)] for t in months[0:4]) == D[3], name="Delivery3")
model.addConstr(cp.quicksum(x[(4, t)] for t in months[1:5]) == D[4], name="Delivery4")
model.addConstr(cp.quicksum(x[(5, t)] for t in months) == D[5], name="Delivery5")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f} yuan".format(model.objval))
    for i in products:
        for t in months:
            if x[(i, t)].x > 0:
                print(f"Quantity of product {i} produced in month {t}: {x[(i, t)].x:.2f} units")
else:
    print("No optimal solution found.")
```

