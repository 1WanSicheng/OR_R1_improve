model.addConstr(x >= 12, name="MinProductionConstraintX")  # Minimum production requirement for model X computers
model.addConstr(z <= 0.25*(x + y + z), name="ProductionRatioConstraintZ")  # Production ratio constraint for model Z computers

# Set the objective function to maximize total profit
model.setObjective(100*x + 125*y + 200*z, sense=COPT.MAXIMIZE)

# Solve the model
