import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("SoftwareProductAllocation")

# Product data
products = ['AppX', 'AppY', 'AppZ', 'AppW', 'AppV']
revenue = {'AppX': 100000, 'AppY': 150000, 'AppZ': 200000, 'AppW': 120000, 'AppV': 180000}
