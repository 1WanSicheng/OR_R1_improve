    print("Minimum total cost: {:.0f}".format(model.objval))
    print("Optimal resource allocation:")
    print("Project X1: {:.0f} units".format(x1.x))
    print("Project X2: {:.0f} units".format(x2.x))
    print("Project X3: {:.0f} units".format(x3.x))
    print("Project X4: {:.0f} units".format(x4.x))
else:
    print("No optimal solution found.")
```

