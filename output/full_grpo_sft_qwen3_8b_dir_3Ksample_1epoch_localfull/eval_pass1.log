```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("HospitalStaffAllocation")

# Add decision variables
d = model.addVar(lb=0, vtype=COPT.INTEGER, name="Doctors")
n = model.addVar(lb=0, vtype=COPT.INTEGER, name="Nurses")

# Add constraints
model.addConstr(d + n >= 20, name="TotalStaffConstraint")
model.addConstr(2*d - n <= 10, name="DoctorNurseDifferenceConstraint1")
model.addConstr(n - 2*d <= 10, name="DoctorNurseDifferenceConstraint2")

# Set the objective function
model.setObjective(10*d + 5*n, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.0f}".format(model.objval))
    print("Optimal staff allocation:")
    print("Number of doctors: {:.0f}".format(d.x))
    print("Number of nurses: {:.0f}".format(n.x))
else:
    print("No optimal solution found.")
```

