    print("Maximized profit: {:.2f}".format(model.objval))
    print("Optimal production plan:")
    print("Number of math workbooks: {:.0f}".format(x.x))
    print("Number of English workbooks: {:.0f}".format(y.x))
else:
    print("No optimal solution found.")
```

