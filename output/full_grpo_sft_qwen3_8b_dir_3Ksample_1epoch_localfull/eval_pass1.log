import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("LogisticsNetworkOptimization")

# Define the cities
cities = [0, 1, 2, 3, 4, 5, 6]

# Define the route capacities
capacities = {
    (0, 1): 20, (0, 2): 19, (0, 3): 18, (0, 5): 11, (0, 6): 2,
