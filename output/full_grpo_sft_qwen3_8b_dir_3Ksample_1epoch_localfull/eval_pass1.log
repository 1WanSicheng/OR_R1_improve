## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this investment problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("InvestmentOptimization")

# Define decision variables
x_oil = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_oil")
x_auto = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_auto")
x_pharmaceutical = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_pharmaceutical")

# Set the objective function
model.setObjective(11*x_oil + 4*x_auto + 2*x_pharmaceutical, sense=COPT.MAXIMIZE)

# Add constraints
model.addConstr(120*x_oil + 52*x_auto + 18*x_pharmaceutical <= 100000, name="TotalInvestmentConstraint")
model.addConstr(x_oil + x_auto + x_pharmaceutical <= 3, name="StockNumberConstraint")
model.addConstr(120*x_oil <= 0.4*100000, name="OilStockInvestmentConstraint")
model.addConstr(52*x_auto <= 0.4*100000, name="AutoStockInvestmentConstraint")
model.addConstr(18*x_pharmaceutical <= 0.4*100000, name="PharmaceuticalStockInvestmentConstraint")
model.addConstr(120*x_oil >= 10000, name="MinimumOilStockInvestmentConstraint")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized annual income: {:.2f}".format(model.objval))
    print("Optimal investment strategy:")
    print("Number of shares of oil stock: {:.0f}".format(x_oil.x))
    print("Number of shares of auto stock: {:.0f}".format(x_auto.x))
    print("Number of shares of pharmaceutical stock: {:.0f}".format(x_pharmaceutical.x))
else:
    print("No optimal solution found.")
```

