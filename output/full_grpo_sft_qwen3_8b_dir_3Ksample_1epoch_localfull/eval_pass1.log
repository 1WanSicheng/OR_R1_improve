model.setObjective(cp.quicksum(regular_cost * P[t] + overtime_cost * O[t] + inventory_cost * I[t] for t in range(6)), sense=COPT.MINIMIZE)

# Add constraints
# Demand satisfaction
for t in range(6):
    model.addConstr(P[t] + O[t] + I[t-1] == demand[t], name=f"Demand_{t}")

# Production capacity constraints
for t in range(6):
    model.addConstr(P[t] <= regular_capacity, name=f"RegularCapacity_{t}")
    model.addConstr(O[t] <= overtime_capacity, name=f"OvertimeCapacity_{t}")

# Initial inventory
model.addConstr(I[0] == 10, name="InitialInventory")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.2f}".format(model.objval))
    print("Optimal production and inventory plan:")
    for t in range(6):
        print(f"Month {t+1}: Regular-time production = {P[t].x:.0f}, Overtime production = {O[t].x:.0f}, Inventory = {I[t].x:.0f}")
else:
    print("No optimal solution found.")
```

