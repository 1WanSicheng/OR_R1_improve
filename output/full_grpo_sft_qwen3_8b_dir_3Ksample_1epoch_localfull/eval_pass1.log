model.addConstr(x1 <= 300, name="DemandLimit1")  # Demand limit for Croissant
model.addConstr(x2 <= 250, name="DemandLimit2")  # Demand limit for Danish
model.addConstr(x3 <= 200, name="DemandLimit3")  # Demand limit for Baguette
model.addConstr(x4 <= 150, name="DemandLimit4")  # Demand limit for Tart
model.addConstr(x1 + x2 + x3 + x4 <= 700, name="ProductionCapacityConstraint")  # Production capacity constraint

# Set the objective function
model.setObjective(3*x1 + 4*x2 + 5*x3 + 6*x4 + 0.02*(x1 - 100) + 0.02*(x2 - 100) + 0.02*(x3 - 100) + 0.02*(x4 - 100), sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f}".format(model.objval))
    print("Optimal production quantities:")
    print("Croissant: {:.0f}".format(x1.x))
    print("Danish: {:.0f}".format(x2.x))
    print("Baguette: {:.0f}".format(x3.x))
    print("Tart: {:.0f}".format(x4.x))
else:
    print("No optimal solution found.")
```

