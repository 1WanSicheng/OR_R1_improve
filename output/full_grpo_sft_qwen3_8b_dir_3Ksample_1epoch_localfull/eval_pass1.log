```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("BoxOptimization")

# Add decision variables
x = model.addVar(lb=0, name="x")  # Length of the base
y = model.addVar(lb=0, name="y")  # Height of the box

# Add constraints
model.addConstr(x*x*y >= 200, name="VolumeConstraint")  # Volume constraint

# Set the objective function
model.setObjective(2*x*x + 4*x*y, sense=COPT.MINIMIZE)  # Minimize material used

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum material used: {:.2f} square inches".format(model.objval))
    print("Optimal dimensions: Length = {:.2f} inches, Height = {:.2f} inches".format(x.x, y.x))
else:
