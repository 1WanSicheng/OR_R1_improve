import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ResourceAllocation")

# Add decision variables
x_X = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_X")
x_Y = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_Y")
