```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FertilizerProductionOptimization")

# Define decision variables
x = {
    ('Super Two', 'Fresno'): model.addVar(lb=0, name="x_SuperTwo_Fresno"),
    ('Super Two', 'Dearborn'): model.addVar(lb=0, name="x_SuperTwo_Dearborn"),
    ('Green Grow', 'Fresno'): model.addVar(lb=0, name="x_GreenGrow_Fresno"),
    ('Green Grow', 'Dearborn'): model.addVar(lb=0, name="x_GreenGrow_Dearborn")
}

# Define the objective function
model.setObjective(
    (9-2)*x[('Super Two', 'Fresno')] + (9-4)*x[('Super Two', 'Dearborn')] +
    (7-2)*x[('Green Grow', 'Fresno')] + (7-3)*x[('Green Grow', 'Dearborn')],
    sense=COPT.MAXIMIZE
)

# Add constraints
# Production capacity constraints of the plants
model.addConstr(x[('Super Two', 'Fresno')] + x[('Green Grow', 'Fresno')] <= 5000, name="Fresno_Capacity")
model.addConstr(x[('Super Two', 'Dearborn')] + x[('Green Grow', 'Dearborn')] <= 6000, name="Dearborn_Capacity")

# Budget constraint
model.addConstr(
    2*x[('Super Two', 'Fresno')] + 4*x[('Super Two', 'Dearborn')] +
    2*x[('Green Grow', 'Fresno')] + 3*x[('Green Grow', 'Dearborn')] <= 45000,
    name="Budget_Constraint"
)

# Maximum demand constraints
model.addConstr(x[('Super Two', 'Fresno')] + x[('Super Two', 'Dearborn')] <= 6000, name="SuperTwo_Demand")
model.addConstr(x[('Green Grow', 'Fresno')] + x[('Green Grow', 'Dearborn')] <= 7000, name="GreenGrow_Demand")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f} dollars".format(model.objval))
    print("Optimal production quantities:")
    for key, var in x.items():
        print(f"{key[0]} at {key[1]}: {var.x:.2f} pounds")
else:
    print("No optimal solution found.")
```

