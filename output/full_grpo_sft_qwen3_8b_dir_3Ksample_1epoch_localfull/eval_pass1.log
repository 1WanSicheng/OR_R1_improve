import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("DorianAutoOptimization")

# Define the data
magazines = ['IJ', 'FS']
ad_numbers = range(1, 16)
exposures = {
    'IJ': {1: 10000, 2: 10000, 3: 10000, 4: 10000, 5: 10000, 6: 10000, 7: 3000, 8: 3000, 9: 3000, 10: 3000, 11: 2500, 12: 2500, 13: 2500, 14: 2500, 15: 2500},
