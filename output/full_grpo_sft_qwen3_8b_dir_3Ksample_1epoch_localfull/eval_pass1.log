model.addConstr(2.5*x2 + 0.75*x3 - x1 - x4 <= 30, name="DiversifiedPortfolioConstraint")  # Constraint on diversified portfolio risk management

# Set the objective function to minimize total cost
model.setObjective(500*x1 + 300*x2 + 200*x3 + 100*x4, sense=COPT.MINIMIZE)

# Solve the model
