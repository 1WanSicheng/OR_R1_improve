```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("AdvertisingOptimization")

# Add decision variables
x1 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x1")  # Number of television commercials
x2 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x2")  # Number of radio commercials
