    (7, 6): 3, (7, 'T'): 1, ('T', 5): 5, ('T', 7): 1
}

# Add variables
distances = {node: model.addVar(lb=0, name=f"dist_{node}") for node in nodes}

# Set the starting node
start_node = 'S'

# Set the target node
end_node = 'T'

# Add constraints
for node in nodes:
    if node == start_node:
        model.addConstr(distances[node] == 0, name=f"start_dist_{node}")
    else:
        model.addConstr(distances[node] >= 0, name=f"non_negative_dist_{node}")

for (u, v), weight in edges.items():
    model.addConstr(distances[v] <= distances[u] + weight, name=f"edge_constraint_{u}_{v}")

# Set the objective
model.setObjective(distances[end_node], sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
