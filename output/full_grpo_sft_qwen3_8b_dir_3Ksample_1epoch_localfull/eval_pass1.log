## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve the optimization problem for the logistics company:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("LogisticsOptimization")

# Define goods types
goods = ['X', 'Y', 'Z']

# Define parameters
total_trucks = 50
fuel_upgrade_budget = 60000
max_trips_per_truck = 20
min_trucks_X = 10
min_trucks_Y = 15

# Define revenue and fuel cost per trip
revenue = {'X': 500, 'Y': 600, 'Z': 700}
fuel_cost = {'X': 200, 'Y': 250, 'Z': 300}

# Add decision variables
x = {i: model.addVar(lb=0, vtype=COPT.INTEGER, name=f"x_{i}") for i in goods}
y = {i: model.addVar(lb=0, vtype=COPT.INTEGER, name=f"y_{i}") for i in goods}
z = model.addVar(lb=0, vtype=COPT.INTEGER, name="z")

# Set the objective function
model.setObjective(cp.quicksum((revenue[i] - fuel_cost[i]) * x[i] * y[i] for i in goods) - z, sense=COPT.MAXIMIZE)

# Add constraints
# Total number of trucks
model.addConstr(cp.quicksum(x[i] for i in goods) <= total_trucks, name="TotalTrucks")

# Total investment in fuel efficiency upgrades
model.addConstr(z <= fuel_upgrade_budget, name="FuelUpgradeBudget")

# Operational constraints
for i in goods:
    model.addConstr(y[i] <= max_trips_per_truck, name=f"MaxTrips_{i}")

# Minimum number of trucks allocated to GoodsX and GoodsY
model.addConstr(x['X'] >= min_trucks_X, name="MinTrucksX")
model.addConstr(x['Y'] >= min_trucks_Y, name="MinTrucksY")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f}".format(model.objval))
    print("Optimal number of trucks allocated to each type of goods:")
    for i in goods:
        print(f"Goods {i}: {x[i].x} trucks")
    print("Optimal number of trips per truck:")
    for i in goods:
        print(f"Goods {i}: {y[i].x} trips")
    print("Total investment in fuel efficiency upgrades: {:.2f}".format(z.x))
else:
    print("No optimal solution found.")
```

This script first defines the goods types, parameters, and revenue and fuel cost per trip. Then, it creates decision variables, including the number of trucks allocated to each type of goods, the number of trips per truck, and the total investment in fuel efficiency upgrades.

