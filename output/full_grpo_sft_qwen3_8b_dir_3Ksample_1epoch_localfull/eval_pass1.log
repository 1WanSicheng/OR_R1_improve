```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("EnvironmentalProjectOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Effort for Project X
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Effort for Project Y
z = model.addVar(lb=0, vtype=COPT.INTEGER, name="z")  # Effort for Project Z

# Add constraints
