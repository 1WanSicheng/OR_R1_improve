model.addConstr(5*y <= 2000, name="ChickenMeatAvailability")  # Chicken meat availability
model.addConstr(y >= 0.25*(x + y), name="ChickenCurryRatio")  # Chicken curry ratio
model.addConstr(x >= y, name="GoatCurryRatio")  # Goat curry ratio

