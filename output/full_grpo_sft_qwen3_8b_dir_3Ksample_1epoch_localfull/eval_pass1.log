# Objective function: Minimize total walking distance
model.setObjective(cp.quicksum(
    x[i] * x[j] * cp.sqrt((villages[i]['x'] - villages[j]['x'])**2 + (villages[i]['y'] - villages[j]['y'])**2) *
    villages[i]['students'] * villages[j]['students'] for i in villages for j in villages if i != j
), sense=COPT.MINIMIZE)

# Constraints
