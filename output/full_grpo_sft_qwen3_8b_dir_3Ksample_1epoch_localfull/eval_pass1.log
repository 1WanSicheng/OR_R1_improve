```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("KnapsackProblem")

# Define the weights and values of the items
weights = [3, 6, 5, 5]
values = [15, 25, 12, 10]

# Define the weight limit of the knapsack
capacity = 12

# Add decision variables
x = [model.addVar(vtype=COPT.BINARY, name=f"x_{i}") for i in range(4)]

# Set the objective function
model.setObjective(cp.quicksum(values[i] * x[i] for i in range(4)), sense=COPT.MAXIMIZE)

# Add the weight limit constraint
model.addConstr(cp.quicksum(weights[i] * x[i] for i in range(4)) <= capacity, name="CapacityConstraint")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
