model.addConstr(7.5*x_A + 4.5*x_B <= 675, name="MaterialS")
model.addConstr(9*x_A + 6*x_B <= 1200, name="Labor")

# Set the objective function
model.setObjective(3*x_A + 4*x_B, sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit: {:.2f}".format(model.objval))
    print("Optimal production quantities:")
    print("Product A: {:.2f} units".format(x_A.x))
    print("Product B: {:.2f} units".format(x_B.x))
else:
    print("No optimal solution found.")
```

