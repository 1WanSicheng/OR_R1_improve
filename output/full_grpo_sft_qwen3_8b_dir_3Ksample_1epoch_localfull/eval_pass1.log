    print("  Glue 3: {:.2f} workers".format(x_13.x))
    print("Production line 2:")
    print("  Glue 1: {:.2f} workers".format(x_21.x))
    print("  Glue 2: {:.2f} workers".format(x_22.x))
    print("  Glue 3: {:.2f} workers".format(x_23.x))
else:
    print("No optimal solution found.")
```

