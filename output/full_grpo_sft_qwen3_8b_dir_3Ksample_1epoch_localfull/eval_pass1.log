env = cp.Envr()

# Create a model
model = env.createModel("ProductionOptimization")

# Add decision variables
x_A = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="x_A")
x_B = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="x_B")

