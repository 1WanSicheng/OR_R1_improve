```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FertilizerMixing")

# Fertilizer data
fertilizers = {
    1: {'a': 10, 'b': 8, 'c': 12, 'price': 21.75},
    2: {'a': 8, 'b': 11, 'c': 15, 'price': 23.50},
    3: {'a': 12, 'b': 7, 'c': 12, 'price': 22.00},
    4: {'a': 10, 'b': 10, 'c': 10, 'price': 19.50},
    5: {'a': 15, 'b': 10, 'c': 6, 'price': 18.50}
}

# Add decision variables
x = {i: model.addVar(lb=0, name=f"x_{i}") for i in fertilizers}

# Objective function: Minimize cost per pound
model.setObjective(cp.quicksum(fertilizers[i]['price'] / 100 * x[i] for i in fertilizers), sense=COPT.MINIMIZE)

# Constraints
# Nitrogen content
model.addConstr(cp.quicksum(fertilizers[i]['a'] * x[i] for i in fertilizers) >= 10, name="Nitrogen_Lower")
model.addConstr(cp.quicksum(fertilizers[i]['a'] * x[i] for i in fertilizers) <= 10.5, name="Nitrogen_Upper")

# Phosphorus content
model.addConstr(cp.quicksum(fertilizers[i]['b'] * x[i] for i in fertilizers) >= 8, name="Phosphorus_Lower")
model.addConstr(cp.quicksum(fertilizers[i]['b'] * x[i] for i in fertilizers) <= 8.5, name="Phosphorus_Upper")

# Potash content
model.addConstr(cp.quicksum(fertilizers[i]['c'] * x[i] for i in fertilizers) >= 12, name="Potash_Lower")
model.addConstr(cp.quicksum(fertilizers[i]['c'] * x[i] for i in fertilizers) <= 12.5, name="Potash_Upper")

# Proportion constraints
model.addConstr(cp.quicksum(x[i] for i in fertilizers) == 1, name="Proportion")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum cost per pound: {:.2f}".format(model.objval))
    print("Optimal fertilizer proportions:")
    for i in fertilizers:
        print(f"Fertilizer {i}: {x[i].x:.2%}")
else:
    print("No optimal solution found.")
```

