import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("SolarPanelOptimization")

# Define the data
zones = ['A', 'B', 'C', 'D', 'E']
energy_output = {'A': 100, 'B': 120, 'C': 150, 'D': 130, 'E': 110}
maintenance_cost = {'A': 2, 'B': 3, 'C': 4, 'D': 3.5, 'E': 2.5}
