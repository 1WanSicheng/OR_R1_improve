```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("InvestmentOptimization")

# Define the stocks and their parameters
stocks = ['Oil', 'Auto', 'Pharmaceutical', 'Tech', 'Green Energy']
returns = {'Oil': 0.10, 'Auto': 0.15, 'Pharmaceutical': 0.20, 'Tech': 0.25, 'Green Energy': 0.18}
risks = {'Oil': 0.05, 'Auto': 0.08, 'Pharmaceutical': 0.10, 'Tech': 0.12, 'Green Energy': 0.07}
prices = {'Oil': 100, 'Auto': 200, 'Pharmaceutical': 150, 'Tech': 250, 'Green Energy': 180}

# Add decision variables
x = {i: model.addVar(lb=0, name=f"x_{i}") for i in stocks}

# Set the objective function
numerator = cp.quicksum(returns[i] * x[i] for i in stocks)
denominator = cp.quicksum(risks[i] * x[i] for i in stocks)
model.setObjective(numerator / denominator, sense=COPT.MAXIMIZE)

# Add constraints
model.addConstr(cp.quicksum(x[i] for i in stocks) <= 100000, name="TotalInvestment")
model.addConstr(cp.quicksum(x[i] for i in stocks) >= 60000, name="MinimumTotalInvestment")
model.addConstr(x['Oil'] >= 9000, name="MinimumOilInvestment")
for i in stocks:
    model.addConstr(x[i] <= 0.4 * 100000, name=f"MaximumSingleStockInvestment_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized Benefit-Risk ratio: {:.2f}".format(model.objval))
    print("Optimal investment amounts:")
    for i in stocks:
        print(f"{i}: ${x[i].x:.2f}")
else:
    print("No optimal solution found.")
