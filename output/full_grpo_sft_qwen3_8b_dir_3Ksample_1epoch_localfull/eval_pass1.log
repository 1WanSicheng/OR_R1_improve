model.setObjective(cp.quicksum((expected_yield[i] * price_per_kg[i] - labor_cost_per_hour[i] * y[i]) * x[i] for i in crops), sense=COPT.MAXIMIZE)

# Add constraints
# Land area constraint
model.addConstr(cp.quicksum(x[i] for i in crops) <= 100, name="LandConstraint")

# Labor hours constraint
model.addConstr(cp.quicksum(labor_cost_per_hour[i] * y[i] * x[i] for i in crops) <= 500, name="LaborConstraint")

# Minimum land area for Wheat
model.addConstr(x['Wheat'] >= 30, name="WheatConstraint")

# Minimum labor hours per acre
for i in crops:
    model.addConstr(y[i] >= 1, name=f"MinLaborConstraint_{i}")

# Solve the model
