# Create a model
model = env.createModel("MedicalSupplyAllocation")

# Define the data
regions = [1, 2, 3, 4, 5]
stock = {1: 410, 2: 266, 3: 132, 4: 6, 5: 485}
demand = {1: 274, 2: 331, 3: 232, 4: 359, 5: 74}
