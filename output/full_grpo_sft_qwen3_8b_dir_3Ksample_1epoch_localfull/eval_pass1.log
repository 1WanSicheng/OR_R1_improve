# Objective function: Minimize the maximum production time
max_time = model.addVar(lb=0, name="max_time")
for j in range(1, num_glues+1):
    model.addConstr(cp.quicksum(production_capacity[i, j] * x[i, j] for i in range(1, num_lines+1)) >= demand[j] / max_time, name=f"Demand_{j}")

model.setObjective(max_time, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum maximum production time: {:.2f} hours".format(model.objval))
    for i in range(1, num_lines+1):
        for j in range(1, num_glues+1):
            print(f"Number of workers assigned to production line {i} for producing glue {j}: {x[i, j].x}")
else:
    print("No optimal solution found.")
