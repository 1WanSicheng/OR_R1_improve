```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("WorkbookProduction")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of math workbooks
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of English workbooks

# Add constraints
model.addConstr(x >= 40, name="MathDemand")  # Demand constraint for math workbooks
model.addConstr(y >= 60, name="EnglishDemand")  # Demand constraint for English workbooks
model.addConstr(x <= 140, name="MathCapacity")  # Production capacity constraint for math workbooks
model.addConstr(y <= 170, name="EnglishCapacity")  # Production capacity constraint for English workbooks
model.addConstr(x + y >= 200, name="SchoolContract")  # Contract constraint

# Set the objective function
model.setObjective(15*x + 17*y, sense=COPT.MAXIMIZE)  # Maximize profit

# Solve the model
model.solve()

# Output the results
