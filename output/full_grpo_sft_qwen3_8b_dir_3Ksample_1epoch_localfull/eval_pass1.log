import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FarmTransportation")

# Add decision variables
x1 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x1")  # Number of trips using horses
x2 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x2")  # Number of trips using bicycles
x3 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x3")  # Number of trips using hand carts

