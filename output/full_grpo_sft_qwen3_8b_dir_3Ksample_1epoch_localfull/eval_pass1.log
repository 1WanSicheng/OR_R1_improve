model.addConstr(x_Y >= 30, name="MinStaffY")
model.addConstr(x_Z >= 20, name="MinStaffZ")

# Set the objective function
model.setObjective(5000*x_X + 4000*x_Y + 6000*x_Z, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.0f}".format(model.objval))
