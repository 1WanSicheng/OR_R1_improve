model.addConstr(2*x + 3*y + z >= 5000, name="RequirementConstraint")  # Requirement constraint
model.addConstr(x - y + z <= 3000, name="BalancedConstraint")  # Balanced resource distribution constraint

# Set the objective function to minimize total cost
model.setObjective(10*x + 20*y + 30*z, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.0f}".format(model.objval))
    print("Optimal resource allocation:")
    print("Project X: {:.0f} units".format(x.x))
    print("Project Y: {:.0f} units".format(y.x))
    print("Project Z: {:.0f} units".format(z.x))
else:
    print("No optimal solution found.")
```

