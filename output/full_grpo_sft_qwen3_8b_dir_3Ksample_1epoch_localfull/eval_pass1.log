model.addConstr(y - z <= 5, name="TimeDifferenceConstraintYZ1")  # Time difference constraint between Y and Z
model.addConstr(z - y <= 5, name="TimeDifferenceConstraintYZ2")  # Time difference constraint between Y and Z

# Set the objective function
