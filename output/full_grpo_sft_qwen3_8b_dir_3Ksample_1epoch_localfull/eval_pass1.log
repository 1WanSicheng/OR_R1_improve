model.addConstr(cp.quicksum(fertilizers[i]['K'] * x[i] for i in fertilizers) <= 12.5, name="Potash_UB")

# Proportion constraint
model.addConstr(cp.quicksum(x[i] for i in fertilizers) == 1, name="Proportion")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.2f} dollars per 100 pounds".format(model.objval))
    print("Optimal fertilizer mix proportions:")
    for i in fertilizers:
        print(f"Fertilizer {i}: {x[i].x:.2%}")
else:
    print("No optimal solution found.")
