# Add constraints
model.addConstr(x <= 3, name="RaceCarProductionConstraint")  # Race car production constraint
model.addConstr(y <= 5, name="RegularCarProductionConstraint")  # Regular car production constraint
model.addConstr(x + y <= 6, name="SafetyCheckConstraint")  # Safety check constraint

# Set the objective function
