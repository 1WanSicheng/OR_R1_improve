    model.addConstr(cp.quicksum(x[i][j] for j in range(num_stores)) <= supply_capacities[i] * y[i], name=f"Supply_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.2f}".format(model.objval))
    print("Opened distribution centers:")
    for i in range(num_centers):
        if y[i].x > 0.5:
