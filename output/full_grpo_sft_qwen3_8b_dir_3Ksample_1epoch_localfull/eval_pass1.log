import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("PostOfficeStaffing")

# Define the number of employees needed each day of the week
required_staff = [15, 13, 15, 18, 14, 16, 10]

# Add decision variables
x = [model.addVar(vtype=COPT.INTEGER, name=f"x_{i}") for i in range(7)]

# Set the objective function
model.setObjective(cp.quicksum(x[i] for i in range(7)), sense=COPT.MINIMIZE)

# Add constraints
for i in range(7):
