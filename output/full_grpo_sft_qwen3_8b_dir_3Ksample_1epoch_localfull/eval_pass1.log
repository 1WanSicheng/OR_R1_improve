    4: {'N': 10, 'P': 10, 'K': 10, 'cost': 19.50},
    5: {'N': 15, 'P': 10, 'K': 6, 'cost': 18.50}
}

# Add decision variables
x = {i: model.addVar(lb=0, name=f"x_{i}") for i in fertilizers}

# Objective function: Minimize total cost
model.setObjective(cp.quicksum(fertilizers[i]['cost'] * x[i] for i in fertilizers), sense=COPT.MINIMIZE)

# Constraints
