```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ShortestPath")

# Define nodes
nodes = ['S', 'T', 2, 3, 4, 5, 6, 7]

# Define edges and weights
edges = {
    ('S', 2): 4, ('S', 3): 5, (2, 'S'): 5, (2, 4): 3, (2, 3): 2,
