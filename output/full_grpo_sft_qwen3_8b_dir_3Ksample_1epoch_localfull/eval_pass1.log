required_cars = [300, 400, 800, 200, 300]

# Add decision variables
x = [[model.addVar(lb=0, name=f"x_{i}_{j}") for j in range(5)] for i in range(5)]

# Set the objective function
model.setObjective(cp.quicksum(costs[i][j] * x[i][j] for i in range(5) for j in range(5)), sense=COPT.MINIMIZE)

# Add constraints
for i in range(5):
    model.addConstr(cp.quicksum(x[i][j] for j in range(5)) == required_cars[i] - current_cars[i], name=f"Demand_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.0f} units".format(model.objval))
    for i in range(5):
        for j in range(5):
            if i != j and x[i][j].x > 0:
