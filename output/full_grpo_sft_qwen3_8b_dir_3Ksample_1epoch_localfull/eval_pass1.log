# Market research constraint
model.addConstr(x['AppX'] >= 2 * x['AppY'], name="MarketResearchConstraint")

# Marketing budget constraint
model.addConstr(cp.quicksum(marketing_cost[i] * x[i] for i in products) <= 2500000, name="MarketingBudgetConstraint")

# Minimum team constraint
for i in products:
    model.addConstr(x[i] >= 1, name=f"MinTeamConstraint_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized average net profit per team: {:.2f}".format(model.objval))
    print("Optimal team allocation:")
    for i in products:
        print(f"{i}: {x[i].x} teams")
else:
    print("No optimal solution found.")
