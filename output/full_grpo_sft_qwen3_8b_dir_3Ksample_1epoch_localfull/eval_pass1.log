model.addConstr(2*x + y <= 30, name="Requirement2")  # Requirement for two teachers and one classroom
model.addConstr(x - y + z >= 10, name="Requirement3")  # Difference between the number of teachers and classrooms plus the number of textbooks

# Set the objective function to minimize total cost
model.setObjective(2*x + 3*y + 4*z, sense=COPT.MINIMIZE)

# Solve the model
