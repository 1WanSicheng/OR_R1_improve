# Add constraints
model.addConstr(x + y <= 200, name="TotalResourceConstraint")  # Total resource constraint
model.addConstr(3*x + 2*y >= 400, name="PerformanceScoreConstraint")  # Performance score constraint
model.addConstr(x - y >= 50, name="ResourceDifferenceConstraint")  # Resource difference constraint

# Set the objective function to minimize total cost
