```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("InternationalLogisticsOptimization")

# Warehouse data
warehouses = [1, 2, 3, 4, 5, 6]
current_stock = {1: 497, 2: 39, 3: 416, 4: 71, 5: 445, 6: 471}
demand = {1: 161, 2: 257, 3: 252, 4: 251, 5: 372, 6: 370}

# Transportation cost matrix
transport_cost = {
    (1, 2): 5, (1, 3): 7, (1, 4): 5, (1, 5): 27, (1, 6): 49,
    (2, 1): 31, (2, 3): 14, (2, 4): 31, (2, 5): 3, (2, 6): 4,
    (3, 1): 9, (3, 2): 13, (3, 4): 23, (3, 5): 38, (3, 6): 19,
    (4, 1): 47, (4, 2): 34, (4, 3): 7, (4, 5): 34, (4, 6): 35,
    (5, 1): 21, (5, 2): 11, (5, 3): 6, (5, 4): 7, (5, 6): 50,
    (6, 1): 28, (6, 2): 41, (6, 3): 34, (6, 4): 17, (6, 5): 32
}

# Add decision variables
x = {(i, j): model.addVar(lb=0, name=f"x_{i}_{j}") for i in warehouses for j in warehouses if i != j}

# Objective function: Minimize total transportation cost
model.setObjective(cp.quicksum(transport_cost[i, j] * x[i, j] for i in warehouses for j in warehouses if i != j), sense=COPT.MINIMIZE)

# Constraints
# Meet the needs of each warehouse
for i in warehouses:
    model.addConstr(cp.quicksum(x[i, j] for j in warehouses if i != j) == demand[i] - current_stock[i], name=f"Demand_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total transportation cost: {:.2f}".format(model.objval))
    print("Optimal transportation plan:")
    for i in warehouses:
        for j in warehouses:
            if i != j and x[i, j].x > 0:
                print(f"Move {x[i, j].x:.2f} units from Warehouse {i} to Warehouse {j}")
else:
    print("No optimal solution found.")
```

