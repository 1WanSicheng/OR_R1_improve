# Set the objective function
model.setObjective(cp.quicksum(exposure_counts[i][j] * x[(i, j)] for i in magazines for j in ad_counts), sense=COPT.MAXIMIZE)

# Add the budget constraint
model.addConstr(cp.quicksum(cost * x[(i, j)] for i in magazines for j in ad_counts) <= budget, name="BudgetConstraint")

