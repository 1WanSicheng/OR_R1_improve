## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this optimization problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("LogisticsOptimization")

# Define goods and parameters
goods = ['X', 'Y', 'Z']
initial_costs = {'X': 1000, 'Y': 1200, 'Z': 1500}
reductions = {'X': 10, 'Y': 12, 'Z': 15}

# Add decision variables
x = {i: model.addVar(lb=0, name=f"x_{i}") for i in goods}
s = model.addVar(lb=0, name="s")

# Set the objective function
model.setObjective(cp.quicksum(initial_costs[i] * x[i] for i in goods) - 
                   cp.quicksum(reductions[i] * s * x[i] for i in goods), 
                   sense=COPT.MINIMIZE)

# Add constraints
model.addConstr(cp.quicksum(x[i] for i in goods) <= 50, name="TotalTruckConstraint")
model.addConstr(s <= 10000 / 100, name="OptimizationBudgetConstraint")
model.addConstr(x['X'] >= 10, name="MinTruckX")
model.addConstr(x['Y'] >= 15, name="MinTruckY")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total delivery cost: {:.2f}".format(model.objval))
    print("Optimal truck allocation:")
    for i in goods:
        print(f"  Goods {i}: {x[i].x:.0f} trucks")
    print(f"  Route optimization software investment: ${s.x * 100:.0f}")
else:
    print("No optimal solution found.")
```

