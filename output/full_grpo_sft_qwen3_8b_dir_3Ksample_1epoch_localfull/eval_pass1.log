```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ThermometerOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of patients using electronic thermometer
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of patients using regular thermometer

# Add constraints
model.addConstr(3*x + 2*y <= 15000, name="TimeConstraint")  # Time constraint
model.addConstr(x >= 2*y, name="RatioConstraint")  # Ratio constraint
model.addConstr(y >= 50, name="MinRegularThermometer")  # Minimum number of patients for regular thermometer

# Set the objective function
model.setObjective(x + y, sense=COPT.MAXIMIZE)  # Maximize the number of patients

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized number of patients: {}".format(int(model.objval)))
    print("Number of patients using electronic thermometer: {}".format(int(x.x)))
    print("Number of patients using regular thermometer: {}".format(int(y.x)))
else:
    print("No optimal solution found.")
```

