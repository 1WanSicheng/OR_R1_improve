import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("SandDeliveryOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of small containers
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of large containers

# Add constraints
model.addConstr(x == 3*y, name="SmallToLargeRatio")  # The number of small containers used must be thrice the number of large containers used
model.addConstr(x >= 5, name="MinSmallContainers")  # There must be at least 5 small containers used
model.addConstr(y >= 3, name="MinLargeContainers")  # There must be at least 3 large containers used
model.addConstr(x + 3*y <= 100, name="WorkerLimit")  # The total number of workers used must not exceed 100

# Set the objective function
model.setObjective(20*x + 50*y, sense=COPT.MAXIMIZE)  # Maximize the amount of sand delivered

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized amount of sand delivered: {:.2f} units".format(model.objval))
    print("Number of small containers used: {:.0f}".format(x.x))
    print("Number of large containers used: {:.0f}".format(y.x))
else:
    print("No optimal solution found.")
```

