y = {i: model.addVar(lb=0, name=f"y_{i}") for i in goods}  # Number of trips per truck for each type of goods
z = model.addVar(lb=0, name="z")  # Total investment in fuel efficiency upgrades

# Set the objective function
model.setObjective(cp.quicksum((revenue[i] - initial_fuel_cost[i]) * y[i] * x[i] for i in goods) - z, sense=COPT.MAXIMIZE)

# Add constraints
model.addConstr(cp.quicksum(x[i] for i in goods) <= 50, name="TotalTruckConstraint")  # Total number of trucks
model.addConstr(z <= 60000, name="FuelEfficiencyInvestmentConstraint")  # Total investment in fuel efficiency upgrades
for i in goods:
    model.addConstr(y[i] <= 20, name=f"OperationalConstraint_{i}")  # Operational constraints
model.addConstr(x['X'] >= 10, name="MinTruckAllocationX")  # Minimum number of trucks allocated to GoodsX
model.addConstr(x['Y'] >= 15, name="MinTruckAllocationY")  # Minimum number of trucks allocated to GoodsY

# Solve the model
model.solve()

# Output the results
