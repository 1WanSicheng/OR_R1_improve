model.addConstr(x2 - x4 <= 50, name="QuantityDifferenceConstraint2")  # Quantity difference constraint between Aircrafts and Drones

# Set the objective function to minimize total support points
model.setObjective(4*x1 + 3*x2 + 5*x3 + 2*x4, sense=COPT.MINIMIZE)

