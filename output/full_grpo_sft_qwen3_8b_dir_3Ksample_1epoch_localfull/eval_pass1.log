```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("BakeryOptimization")

# Add decision variables
x1 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x1")  # Croissant
x2 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x2")  # Danish
x3 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x3")  # Baguette
x4 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x4")  # Tart

# Add constraints
