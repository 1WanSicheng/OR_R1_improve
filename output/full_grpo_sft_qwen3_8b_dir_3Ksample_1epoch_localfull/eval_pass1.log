# Objective function: Maximize the probability of destroying enemy military targets
model.setObjective(cp.quicksum(prob_heavy[i] * x[i] for i in range(num_areas)), sense=COPT.MAXIMIZE)

# Constraints
# Fuel constraint
model.addConstr(cp.quicksum(distance[i] * x[i] for i in range(num_areas)) <= fuel_limit, name="FuelConstraint")

# Heavy bomb constraint
model.addConstr(cp.quicksum(x[i] for i in range(num_areas)) <= heavy_bomb_limit, name="HeavyBombConstraint")

# Light bomb constraint
model.addConstr(cp.quicksum(x[i] for i in range(num_areas)) <= light_bomb_limit, name="LightBombConstraint")

# Solve the model
model.solve()

# Output the results
