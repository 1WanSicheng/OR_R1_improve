import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ProductionOptimization")

# Define equipment and products
equipment = ['A1', 'A2', 'B1', 'B2', 'B3']
products = ['I', 'II', 'III']

