```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("TravelingSalesmanProblem")

# Define the number of cities
n = 6

# Define the cost matrix
cost = [
    [0, 86, 81, 64, 65, 24],
    [86, 0, 44, 80, 91, 23],
    [81, 44, 0, 15, 25, 89],
    [64, 80, 15, 0, 89, 41],
    [65, 91, 25, 89, 0, 29],
    [24, 23, 89, 41, 29, 0]
]

# Add decision variables
x = [[model.addVar(vtype=COPT.BINARY, name=f"x_{i}_{j}") for j in range(n)] for i in range(n)]

# Set the objective function
model.setObjective(cp.quicksum(cost[i][j] * x[i][j] for i in range(n) for j in range(n) if i != j), sense=COPT.MINIMIZE)

# Add constraints
# Each city is visited exactly once
for i in range(n):
    model.addConstr(cp.quicksum(x[i][j] for j in range(n) if i != j) == 1, name=f"VisitOnce_{i}")

# Each city is left exactly once
for j in range(n):
    model.addConstr(cp.quicksum(x[i][j] for i in range(n) if i != j) == 1, name=f"LeaveOnce_{j}")

# Subtour elimination constraints (Miller-Tucker-Zemlin constraints)
u = [model.addVar(lb=1, ub=n-1, vtype=COPT.INTEGER, name=f"u_{i}") for i in range(n)]
for i in range(1, n):
    for j in range(1, n):
        if i != j:
            model.addConstr(u[i] - u[j] + n * x[i][j] <= n - 1, name=f"SubtourElimination_{i}_{j}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total travel cost: {:.2f}".format(model.objval))
    print("Optimal route:")
    route = [0]
    current_city = 0
    while len(route) < n:
        for j in range(n):
            if x[current_city][j].x > 0.5:
                route.append(j)
                current_city = j
                break
    route.append(route[0])
    for i in range(len(route) - 1):
        print(f"City {route[i]} -> City {route[i+1]}")
else:
    print("No optimal solution found.")
```

This script first defines the number of cities and the cost matrix. Then, it creates the decision variables `x` and sets the objective function to minimize the total travel cost.

Next, the script adds constraints to ensure that each city is visited exactly once and left exactly once. Additionally, it includes the Miller-Tucker-Zemlin constraints to eliminate subtours.

