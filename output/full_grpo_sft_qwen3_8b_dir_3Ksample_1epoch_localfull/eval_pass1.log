model.addConstr(x4 - x1 >= 50, name="UnitDifferenceConstraint1")
model.addConstr(x3 - 2*x4 <= -30, name="UnitDifferenceConstraint2")

# Set the objective function
model.setObjective(5000*x1 + 4000*x2 + 6000*x3 + 7000*x4, sense=COPT.MINIMIZE)

# Solve the model
