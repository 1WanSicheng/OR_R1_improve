```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FertilizerMixOptimization")

# Fertilizer data
fertilizers = {
    1: {'N': 10, 'P': 8, 'K': 12, 'price': 21.75},
    2: {'N': 8, 'P': 11, 'K': 15, 'price': 23.75},
    3: {'N': 12, 'P': 7, 'K': 12, 'price': 22.00},
    4: {'N': 10, 'P': 10, 'K': 10, 'price': 19.50},
    5: {'N': 15, 'P': 10, 'K': 6, 'price': 18.50}
}

# Add decision variables
x = {i: model.addVar(lb=0, name=f"x_{i}") for i in fertilizers}

# Objective function: Minimize total cost
model.setObjective(cp.quicksum(fertilizers[i]['price'] * x[i] for i in fertilizers), sense=COPT.MINIMIZE)

# Constraints
# Nitrogen content requirement
model.addConstr(cp.quicksum(fertilizers[i]['N'] * x[i] for i in fertilizers) >= 10, name="Nitrogen_Lower_Bound")

# Phosphorus content requirement
model.addConstr(cp.quicksum(fertilizers[i]['P'] * x[i] for i in fertilizers) >= 8, name="Phosphorus_Lower_Bound")

# Potash content requirement
model.addConstr(cp.quicksum(fertilizers[i]['K'] * x[i] for i in fertilizers) >= 12, name="Potash_Lower_Bound")

# Upper limits on chemical content
model.addConstr(cp.quicksum(fertilizers[i]['N'] * x[i] for i in fertilizers) <= 10.5, name="Nitrogen_Upper_Bound")
model.addConstr(cp.quicksum(fertilizers[i]['P'] * x[i] for i in fertilizers) <= 8.5, name="Phosphorus_Upper_Bound")
model.addConstr(cp.quicksum(fertilizers[i]['K'] * x[i] for i in fertilizers) <= 12.5, name="Potash_Upper_Bound")

# Proportion constraints
model.addConstr(cp.quicksum(x[i] for i in fertilizers) == 1, name="Proportion_Constraint")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.2f} dollars per 100 pounds".format(model.objval))
    print("Optimal fertilizer mix proportions:")
    for i in fertilizers:
        print(f"Fertilizer {i}: {x[i].x:.2%}")
else:
    print("No optimal solution found.")
```

