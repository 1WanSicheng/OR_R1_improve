total_profit = cp.quicksum((selling_prices[i] - material_costs[i]) * x[i] for i in widgets)
total_time = cp.quicksum(production_times[i] * x[i] for i in widgets)
model.setObjective(total_profit / total_time, sense=COPT.MAXIMIZE)

# Constraints
# Material cost constraint
model.addConstr(cp.quicksum(material_costs[i] * x[i] for i in widgets) <= 900, name="MaterialCostConstraint")

# Production time constraint
model.addConstr(cp.quicksum(production_times[i] * x[i] for i in widgets) <= 400, name="ProductionTimeConstraint")

# Minimum production quantity constraint
for i in widgets:
    model.addConstr(x[i] >= 10, name=f"MinProductionConstraint_{i}")

# Production quantity constraints
model.addConstr(x['W'] <= x['X'] + x['Y'] + x['Z'], name="ProductionConstraint_W")
model.addConstr(x['V'] <= x['X'] + x['Y'] + x['Z'] + x['W'], name="ProductionConstraint_V")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit rate: {:.2f}".format(model.objval))
    print("Optimal production quantities:")
    for i in widgets:
        print(f"Widget {i}: {x[i].x} units")
else:
    print("No optimal solution found.")
