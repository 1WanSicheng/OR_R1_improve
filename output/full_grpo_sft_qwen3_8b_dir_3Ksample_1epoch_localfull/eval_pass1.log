```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("NutritionOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="x")  # Number of servings of almonds
y = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="y")  # Number of servings of cashews

# Add constraints
model.addConstr(200*x + 300*y >= 10000, name="CalorieRequirement")  # Calorie requirement
model.addConstr(20*x + 25*y >= 800, name="ProteinRequirement")  # Protein requirement
model.addConstr(x >= 2*y, name="AlmondCashewRatio")  # Almond-to-cashew ratio

# Set the objective function to minimize fat intake
model.setObjective(15*x + 12*y, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum fat intake: {:.2f} grams".format(model.objval))
    print("Optimal number of servings:")
    print("Almonds: {:.2f} servings".format(x.x))
    print("Cashews: {:.2f} servings".format(y.x))
else:
    print("No optimal solution found.")
```

This script first creates a COPT environment and model. Then, it adds two decision variables, `x` and `y`, representing the number of servings of almonds and cashews, respectively.

