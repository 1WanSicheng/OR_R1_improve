```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("RescueTeamOptimization")

# Add decision variables
x = model.addVar(lb=0, name="x")  # x-coordinate of the rescue team's location
