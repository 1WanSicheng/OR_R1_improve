model.addConstr(x[('C', 5)] == 1, name="Part5_C")

# The number of parts processed on equipment C should not exceed 3
model.addConstr(cp.quicksum(x[('C', j)] for j in range(1, 11)) <= 3, name="C_Limit")

# Solve the model
model.solve()

# Output the results
