import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("ResourceAllocation")

# Add decision variables
x = model.addVar(lb=0, ub=30, vtype=COPT.INTEGER, name="x")  # Number of resource units allocated to Task X
y = model.addVar(lb=0, ub=20, vtype=COPT.INTEGER, name="y")  # Number of resource units allocated to Task Y

