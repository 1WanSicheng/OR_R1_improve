model.addConstr(x - z <= 10, name="FlexibilityTrainingConstraint2")  # Flexibility training time constraint

# Set the objective function
model.setObjective(10*x + 15*y + 20*z, sense=COPT.MINIMIZE)  # Minimize total fatigue score

# Solve the model
model.solve()

# Output the results
