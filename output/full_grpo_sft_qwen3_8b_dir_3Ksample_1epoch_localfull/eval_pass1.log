```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("TelecomResourceAllocation")

# Add decision variables
x1 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x1")
x2 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x2")
x3 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x3")
x4 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x4")

# Add constraints
model.addConstr(x1 + x2 <= 5000, name="BudgetConstraint1")
model.addConstr(x3 + x4 <= 3000, name="BudgetConstraint2")
model.addConstr(x1 + x3 >= 2000, name="QualityConstraint1")
model.addConstr(x2 + x4 >= 4000, name="QualityConstraint2")

# Set the objective function
model.setObjective(50*x1 + 75*x2 + 100*x3 + 125*x4, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.0f}".format(model.objval))
    print("Optimal resource allocation:")
    print("Project 1 (Network Infrastructure): {:.0f} units".format(x1.x))
    print("Project 2 (Service Coverage): {:.0f} units".format(x2.x))
    print("Project 3 (Data Security): {:.0f} units".format(x3.x))
    print("Project 4 (New Technologies): {:.0f} units".format(x4.x))
else:
    print("No optimal solution found.")
```

