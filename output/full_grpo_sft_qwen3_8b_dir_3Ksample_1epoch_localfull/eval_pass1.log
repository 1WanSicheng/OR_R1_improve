# Create a model
model = env.createModel("HighwayTrafficFlow")

# Define the cities
cities = [0, 1, 2, 3, 4, 5]

# Define the capacity of each highway
capacity = {
    (0, 1): 9, (0, 2): 13, (0, 4): 20, (0, 5): 16,
    (1, 0): 6, (1, 2): 19, (1, 3): 11, (1, 4): 14, (1, 5): 15,
    (2, 0): 11, (2, 1): 6, (2, 3): 8, (2, 4): 3, (2, 5): 10,
