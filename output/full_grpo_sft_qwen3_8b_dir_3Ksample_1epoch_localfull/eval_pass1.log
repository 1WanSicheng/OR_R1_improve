```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("TourResourceAllocation")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of resource units allocated to package X
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of resource units allocated to package Y

# Add constraints
model.addConstr(2*x + 3*y <= 50, name="ResourceConstraint")  # Resource constraint
model.addConstr(x + y >= 10, name="MinimumServiceThreshold")  # Minimum service threshold
model.addConstr(x - y <= 20, name="LogisticalConstraint1")  # Logistical constraint
model.addConstr(y - x <= 20, name="LogisticalConstraint2")  # Logistical constraint

# Set the objective function
model.setObjective(100*x + 200*y, sense=COPT.MINIMIZE)  # Minimize total cost

# Solve the model
model.solve()

# Output the results
