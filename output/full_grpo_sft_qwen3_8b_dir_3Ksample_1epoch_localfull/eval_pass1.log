model.addConstr(2*x + y >= 500, name="PortfolioDiversityConstraint")  # Portfolio diversity constraint
model.addConstr(x - y <= 200, name="InvestmentDifferenceConstraint1")  # Investment difference constraint
model.addConstr(y - x <= 200, name="InvestmentDifferenceConstraint2")  # Investment difference constraint

# Set the objective function
