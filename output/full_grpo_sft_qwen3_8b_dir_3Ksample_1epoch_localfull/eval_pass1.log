```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ElectricityProductionOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of times experiment alpha is conducted
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of times experiment beta is conducted

# Add constraints
model.addConstr(3*x + 5*y <= 800, name="MetalConstraint")  # Metal usage constraint
model.addConstr(5*x + 4*y <= 750, name="AcidConstraint")  # Acid usage constraint

# Set the objective function
model.setObjective(8*x + 10*y, sense=COPT.MAXIMIZE)  # Maximize the total amount of electricity produced

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total amount of electricity produced: {:.2f}".format(model.objval))
    print("Number of times experiment alpha is conducted: {:.0f}".format(x.x))
    print("Number of times experiment beta is conducted: {:.0f}".format(y.x))
else:
    print("No optimal solution found.")
```

