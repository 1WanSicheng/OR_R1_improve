    (5, 0): 7, (5, 1): 19, (5, 2): 18, (5, 3): 6, (5, 4): 8
}

# Add decision variables
f = {(i, j): model.addVar(lb=0, name=f"f_{i}_{j}") for i in cities for j in cities if (i, j) in capacity}

# Objective function: Maximize the flow of vehicles from the source to the destination
model.setObjective(cp.quicksum(f[(0, j)] for j in cities if (0, j) in capacity), sense=COPT.MAXIMIZE)

# Constraints
