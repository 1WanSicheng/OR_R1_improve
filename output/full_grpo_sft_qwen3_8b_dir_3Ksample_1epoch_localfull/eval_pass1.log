x2 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x2")
x3 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x3")
x4 = model.addVar(lb=0, vtype=COPT.INTEGER, name="x4")

