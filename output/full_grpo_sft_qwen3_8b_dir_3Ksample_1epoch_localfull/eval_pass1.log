# Create a model
model = env.createModel("WaitstaffScheduling")

# Define time periods and minimum number of waitstaff
time_periods = ["2am-6am", "6am-10am", "10am-2pm", "2pm-6pm", "6pm-10pm", "10pm-2am"]
