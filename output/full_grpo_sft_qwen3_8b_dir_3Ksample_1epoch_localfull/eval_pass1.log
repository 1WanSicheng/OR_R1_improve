    print("Minimum additional price per dish: {:.2f}".format(model.objval))
    print("Optimal quantities of foods:")
    print("Carrot Raw: {:.2f}".format(x1.x))
    print("White Cabbage: {:.2f}".format(x2.x))
    print("Pickled Cucumber: {:.2f}".format(x3.x))
else:
    print("No optimal solution found.")
```

