import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("BombingOptimization")

# Data definition
num_areas = 4
fuel_limit = 48000
heavy_bomb_limit = 48
light_bomb_limit = 32
distance = [480, 540, 600, 0.25]
prob_heavy = [0.10, 0.20, 0.15, 0.20]
prob_light = [0.08, 0.16, 0.12, 0.20]

