```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("MetalExtractionOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of times process J is performed
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of times process P is performed

# Add constraints
model.addConstr(8*x + 6*y <= 1500, name="WaterConstraint")  # Water usage constraint
model.addConstr(3*x + 5*y <= 1350, name="PollutionConstraint")  # Pollution constraint

# Set the objective function
model.setObjective(5*x + 9*y, sense=COPT.MAXIMIZE)  # Maximize the amount of metal extracted

# Solve the model
model.solve()

# Output the results
