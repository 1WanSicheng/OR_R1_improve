# Market demand constraints
for i in blends:
    model.addConstr(x[i] <= demand[i], name=f"Demand_{i}")

# Production capacity constraint
model.addConstr(cp.quicksum(x[i] for i in blends) <= 650, name="ProductionCapacity")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f} dollars".format(model.objval))
    for i in blends:
        print(f"Quantity of {i} blend produced: {x[i].x:.2f} units")
else:
    print("No optimal solution found.")
