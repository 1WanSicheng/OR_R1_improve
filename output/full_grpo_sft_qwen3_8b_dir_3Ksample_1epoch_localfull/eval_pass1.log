model.addConstr(x2 + x3 >= 800, name="Constraint2")
model.addConstr(x3 - x4 == 200, name="Constraint3")
model.addConstr(0.5*x4 - x1 <= 300, name="Constraint4")

# Set the objective function
model.setObjective(4*x1 + 5*x2 + 6*x3 + 7*x4, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

