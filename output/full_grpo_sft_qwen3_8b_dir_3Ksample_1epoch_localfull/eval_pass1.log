# Add decision variables
x = {(i, j): model.addVar(vtype=COPT.BINARY, name=f"x_{i}_{j}") for i in ['A', 'B', 'C'] for j in range(1, 11)}

# Objective function: Minimize the total cost
model.setObjective(cp.quicksum(processing_costs[i][j-1] * x[(i, j)] for i in ['A', 'B', 'C'] for j in range(1, 11)) +
                   cp.quicksum(setup_costs[i] * cp.quicksum(x[(i, j)] for j in range(1, 11)) for i in ['A', 'B', 'C']),
                   sense=COPT.MINIMIZE)

# Constraints
