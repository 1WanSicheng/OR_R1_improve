model.addConstr(x2 + x4 >= 100, name="DemandForecastConstraint2")

# Set the objective function
model.setObjective(1.5*x1 + 2*x2 + 3*x3 + 4*x4, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
