```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("ContainerLoadingOptimization")

# Define the data
goods_types = ['A', 'B', 'C', 'D', 'E']
weights = {'A': 0.5, 'B': 1, 'C': 0.4, 'D': 0.6, 'E': 0.65}
volumes = {'A': 0.65*1*1, 'B': 0.2*2*2, 'C': 0.35*2*1, 'D': 0.2*3*1, 'E': 0.15*5*1}
quantities = {'A': 120, 'B': 90, 'C': 300, 'D': 90, 'E': 120}
container_weight_limit = 60
container_min_weight = 18
container_volume = 15.5 * 2.8 * 2.8

# Add decision variables
x = {(i, j): model.addVar(lb=0, vtype=COPT.CONTINUOUS, name=f"x_{i}_{j}") for i in range(1, 100) for j in goods_types}
y = {i: model.addVar(vtype=COPT.BINARY, name=f"y_{i}") for i in range(1, 100)}

# Set the objective function
model.setObjective(cp.quicksum(y[i] for i in range(1, 100)), sense=COPT.MINIMIZE)

# Add constraints
# Weight constraint
for i in range(1, 100):
    model.addConstr(cp.quicksum(weights[j] * x[i, j] for j in goods_types) <= container_weight_limit, name=f"WeightConstraint_{i}")

# Minimum weight constraint
for i in range(1, 100):
    model.addConstr(cp.quicksum(weights[j] * x[i, j] for j in goods_types) >= container_min_weight, name=f"MinWeightConstraint_{i}")

# Volume constraint
for i in range(1, 100):
    model.addConstr(cp.quicksum(volumes[j] * x[i, j] for j in goods_types) <= container_volume, name=f"VolumeConstraint_{i}")

# Specific packaging requirements
for i in range(1, 100):
    model.addConstr(x[i, 'A'] <= x[i, 'C'], name=f"PackagingConstraint_{i}")

# Demand restrictions of goods D
for i in range(1, 100):
    model.addConstr(x[i, 'D'] >= 12, name=f"DemandConstraint_{i}")

# Inventory limitations
for j in goods_types:
    model.addConstr(cp.quicksum(x[i, j] for i in range(1, 100)) <= quantities[j], name=f"InventoryConstraint_{j}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum number of containers: {:.0f}".format(model.objval))
    for i in range(1, 100):
        if y[i].x > 0.5:
            print(f"Container {i}:")
            for j in goods_types:
                if x[i, j].x > 0:
                    print(f"  Goods {j}: {x[i, j].x:.0f} units")
else:
    print("No optimal solution found.")
```

