```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("MaxFlowProblem")

# Define the nodes and edges
nodes = [1, 2, 3, 4]
edges = {
    (1, 2): 5, (1, 3): 7, (2, 3): 2, (2, 4): 4, (3, 4): 12
}

# Add decision variables
f = {(i, j): model.addVar(lb=0, ub=edges[(i, j)], name=f"f_{i}_{j}") for i, j in edges}

# Objective function: Maximize the total flow from the source node
model.setObjective(cp.quicksum(f[(1, j)] for j in nodes if (1, j) in edges), sense=COPT.MAXIMIZE)

# Constraints
# Flow conservation constraints
for i in nodes:
    if i != 1 and i != 4:
        model.addConstr(cp.quicksum(f[(j, i)] for j in nodes if (j, i) in edges) == 
                        cp.quicksum(f[(i, j)] for j in nodes if (i, j) in edges), name=f"FlowConservation_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximum flow: {:.0f}".format(model.objval))
    print("Flow distribution:")
    for i, j in edges:
        if f[(i, j)].x > 0:
            print(f"Flow from node {i} to node {j}: {f[(i, j)].x:.0f}")
else:
    print("No optimal solution found.")
```

