## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this school budget allocation problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("SchoolBudgetAllocation")

# Add decision variables
x_T = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_T")  # Technology
x_P = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_P")  # Physics
x_S = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_S")  # Sports
x_R = model.addVar(lb=0, vtype=COPT.INTEGER, name="x_R")  # Research

# Add constraints
model.addConstr(x_T + x_P <= 50, name="TechPhysicsConstraint")  # Technology and Physics budget allocation constraint
model.addConstr(x_S + x_R <= 30, name="SportsResearchConstraint")  # Sports and Research budget allocation constraint
model.addConstr(x_T >= 15, name="TechRequirement")  # Technology budget allocation requirement
model.addConstr(x_P >= 10, name="PhysicsRequirement")  # Physics budget allocation requirement
model.addConstr(x_S >= 5, name="SportsRequirement")  # Sports budget allocation requirement
model.addConstr(x_R >= 2, name="ResearchRequirement")  # Research budget allocation requirement

# Set the objective function to minimize total cost
model.setObjective(500*x_T + 300*x_P + 200*x_S + 100*x_R, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.0f}".format(model.objval))
    print("Optimal budget allocation:")
    print("Technology: {:.0f} units".format(x_T.x))
    print("Physics: {:.0f} units".format(x_P.x))
    print("Sports: {:.0f} units".format(x_S.x))
    print("Research: {:.0f} units".format(x_R.x))
else:
    print("No optimal solution found.")
```

