# Inventory requirement
model.addConstr(i[num_months-1] >= 10000, name="InventoryRequirement")

# Worker number constraints
for t in range(num_months):
    if t == 0:
        model.addConstr(i[t] == initial_workers, name=f"Worker_{t}")
    else:
        model.addConstr(i[t] == i[t-1] + h[t] - f[t], name=f"Worker_{t}")

# Overtime hour constraints
for t in range(num_months):
    model.addConstr(labor_hours * normal_wage * normal_hours * p[t] / initial_workers * overtime_hours / 20 <= 
                    labor_hours * normal_wage * normal_hours * p[t] / initial_workers, name=f"Overtime_{t}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total net profit: {:.2f}".format(model.objval))
    print("Production plan:")
    for t in range(num_months):
