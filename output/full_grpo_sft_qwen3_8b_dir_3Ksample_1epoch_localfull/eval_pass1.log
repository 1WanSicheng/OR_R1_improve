## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve the optimization problem for Basel Tool and Die Company:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("BaselToolAndDieOptimization")

# Define the demand for each month
demand = [430, 430, 380, 450, 520, 440]

# Define the production capacity
regular_capacity = 420
overtime_capacity = 80

# Add decision variables
P = [model.addVar(lb=0, name=f"P_{t}") for t in range(6)]
O = [model.addVar(lb=0, name=f"O_{t}") for t in range(6)]
I = [model.addVar(lb=0, name=f"I_{t}") for t in range(6)]

# Set the objective function
model.setObjective(cp.quicksum(40*P[t] + 45*O[t] + 3*I[t] for t in range(6)), sense=COPT.MINIMIZE)

# Add constraints
# Demand satisfaction
for t in range(6):
    model.addConstr(P[t] + O[t] + I[t-1] == demand[t], name=f"Demand_{t}")

# Production capacity constraints
for t in range(6):
    model.addConstr(P[t] <= regular_capacity, name=f"RegularCapacity_{t}")
    model.addConstr(O[t] <= overtime_capacity, name=f"OvertimeCapacity_{t}")

# Initial inventory
model.addConstr(I[0] == 10, name="InitialInventory")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.0f}".format(model.objval))
    print("Optimal production and inventory plan:")
    for t in range(6):
        print(f"Month {t+1}: Regular-time production = {P[t].x:.0f}, Overtime production = {O[t].x:.0f}, Inventory = {I[t].x:.0f}")
else:
    print("No optimal solution found.")
```

