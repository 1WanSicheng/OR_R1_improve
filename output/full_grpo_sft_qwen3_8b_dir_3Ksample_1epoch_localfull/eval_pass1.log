## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("CourseSelection")

# Define the list of courses
courses = ["Calculus", "Operations Research", "Data Structures", "Business Statistics", "Computer Simulation", "Introduction to Computer Programming", "Forecasting"]

# Add decision variables
x = {course: model.addVar(vtype=COPT.BINARY, name=f"x_{course}") for course in courses}

# Objective function: Minimize the number of courses
model.setObjective(cp.quicksum(x[course] for course in courses), sense=COPT.MINIMIZE)

# Constraints
# Math requirement
model.addConstr(x["Calculus"] + x["Business Statistics"] + x["Data Structures"] + x["Forecasting"] >= 2, name="MathRequirement")

# OR requirement
model.addConstr(x["Operations Research"] + x["Business Statistics"] + x["Computer Simulation"] + x["Forecasting"] >= 2, name="ORRequirement")

# Computer requirement
model.addConstr(x["Data Structures"] + x["Computer Simulation"] + x["Introduction to Computer Programming"] >= 2, name="ComputerRequirement")

# Prerequisites
model.addConstr(x["Business Statistics"] <= x["Calculus"], name="BusinessStatisticsPrerequisite")
model.addConstr(x["Computer Simulation"] <= x["Introduction to Computer Programming"], name="ComputerSimulationPrerequisite")
model.addConstr(x["Data Structures"] <= x["Introduction to Computer Programming"], name="DataStructuresPrerequisite")
model.addConstr(x["Forecasting"] <= x["Business Statistics"], name="ForecastingPrerequisite")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum number of courses:", model.objval)
    print("Selected courses:")
    for course in courses:
        if x[course].x == 1:
            print(course)
else:
    print("No optimal solution found.")
```

