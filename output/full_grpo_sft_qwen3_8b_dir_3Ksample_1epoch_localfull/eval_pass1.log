```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("WineBlendingOptimization")

# Wine grades and brands
wine_grades = ['I', 'II']
brands = ['red', 'yellow', 'blue']

# Wine supply and cost
supply = {'I': 1500, 'II': 1000}
cost = {'I': 6, 'II': 3}

# Selling prices
selling_prices = {'red': 5.5, 'yellow': 5.0, 'blue': 4.8}

# Add decision variables
x = {(i, j): model.addVar(lb=0, name=f"x_{i}_{j}") for i in wine_grades for j in brands}

# Objective function: Maximize profit
model.setObjective(cp.quicksum((selling_prices[j] - cost[i]) * x[i, j] for i in wine_grades for j in brands), sense=COPT.MAXIMIZE)

# Constraints
# Wine supply constraints
for i in wine_grades:
    model.addConstr(cp.quicksum(x[i, j] for j in brands) <= supply[i], name=f"Supply_{i}")

# Blending ratio constraints
for j in brands:
    if j == 'red':
        model.addConstr(0.1 * cp.quicksum(x['I', j] for j in brands) <= x['I', j], name=f"Red_Lower_{j}")
        model.addConstr(x['I', j] <= 0.5 * cp.quicksum(x['I', j] for j in brands), name=f"Red_Upper_{j}")
    elif j == 'yellow':
        model.addConstr(0.2 * cp.quicksum(x['I', j] for j in brands) <= x['I', j], name=f"Yellow_Lower_{j}")
        model.addConstr(x['I', j] <= 0.7 * cp.quicksum(x['I', j] for j in brands), name=f"Yellow_Upper_{j}")
    else:  # blue
        model.addConstr(0.1 * cp.quicksum(x['I', j] for j in brands) <= x['I', j], name=f"Blue_Lower_{j}")
        model.addConstr(x['I', j] <= 0.5 * cp.quicksum(x['I', j] for j in brands), name=f"Blue_Upper_{j}")

# Minimum production requirement for red brand
model.addConstr(cp.quicksum(x['I', 'red'] for j in brands) >= 2000, name="Red_Minimum")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit: {:.2f} yuan".format(model.objval))
    print("Optimal blending strategy:")
    for i in wine_grades:
        for j in brands:
            if x[i, j].x > 0:
                print(f"Amount of wine grade {i} used to produce brand {j}: {x[i, j].x:.2f} kg")
else:
    print("No optimal solution found.")
```

