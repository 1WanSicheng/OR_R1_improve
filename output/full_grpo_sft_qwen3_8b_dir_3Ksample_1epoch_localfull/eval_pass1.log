model.addConstr(2*x1 + x3 >= 800, name="ResourceAllocationRequirementX1X3")
model.addConstr(x2 - 0.5*x4 >= 300, name="ResourceAllocationRequirementX2X4")
model.addConstr(x2 - x3 - x1 <= 70, name="ResourceAllocationBalanceX1X2X3")

# Set the objective function
model.setObjective(300*x1 + 200*x2 + 500*x3 + 400*x4, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.0f}".format(model.objval))
    print("Optimal resource allocation:")
    print("x1 = {:.0f}".format(x1.x))
    print("x2 = {:.0f}".format(x2.x))
    print("x3 = {:.0f}".format(x3.x))
    print("x4 = {:.0f}".format(x4.x))
else:
    print("No optimal solution found.")
```

