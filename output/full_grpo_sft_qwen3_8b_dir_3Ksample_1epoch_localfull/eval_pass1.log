# Number of trips constraint
model.addConstr(cp.quicksum(x[i] + y[i] for i in goods) <= 100, name="TripConstraint")

# Budget constraint
model.addConstr(cp.quicksum(cost_per_trip['Truck'] * x[i] + cost_per_trip['Drone'] * y[i] 
                            for i in goods) <= 3000, name="BudgetConstraint")

