```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FarmOptimization")

# Define the data
crops = ['A', 'B', 'C', 'D', 'E']
selling_prices = {'A': 20, 'B': 25, 'C': 30, 'D': 35, 'E': 40}
seed_costs = {'A': 5, 'B': 7, 'C': 9, 'D': 11, 'E': 13}
labor_hours = {'A': 3, 'B': 4, 'C': 5, 'D': 6, 'E': 7}

# Add decision variables
x = {i: model.addVar(lb=0, name=f"x_{i}") for i in crops}

# Add constraints
model.addConstr(cp.quicksum(seed_costs[i] * x[i] for i in crops) <= 9900, name="SeedCostConstraint")
model.addConstr(cp.quicksum(labor_hours[i] * x[i] for i in crops) <= 900, name="LaborHourConstraint")
for i in crops:
    model.addConstr(x[i] >= 20, name=f"PlantingQuantityConstraint_{i}")

# Set the objective function
model.setObjective(cp.quicksum((selling_prices[i] - seed_costs[i]) * x[i] for i in crops), sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized profit rate: {:.2f}".format(model.objval))
    print("Optimal planting quantities:")
    for i in crops:
        print(f"Crop {i}: {x[i].x:.2f} tons")
else:
    print("No optimal solution found.")
