```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("LogisticsOptimization")

# Define regions and truck types
regions = ['A', 'B', 'C', 'D', 'E']
truck_types = ['company', 'leased']

# Define costs and revenues
costs = {
    'A': {'company': 500, 'leased': 700},
    'B': {'company': 600, 'leased': 800},
    'C': {'company': 700, 'leased': 900},
    'D': {'company': 800, 'leased': 1000},
    'E': {'company': 900, 'leased': 1100}
}
revenues = {
    'A': {'company': 1200, 'leased': 1200},
    'B': {'company': 1300, 'leased': 1300},
    'C': {'company': 1400, 'leased': 1400},
    'D': {'company': 1500, 'leased': 1500},
    'E': {'company': 1600, 'leased': 1600}
}

# Add decision variables
x = {(i, j): model.addVar(lb=0, vtype=COPT.INTEGER, name=f"x_{i}_{j}") for i in regions for j in truck_types}

# Set the objective function
total_trucks = 40
model.setObjective(cp.quicksum((revenues[i][j] - costs[i][j]) * x[(i, j)] for i in regions for j in truck_types) / total_trucks, sense=COPT.MAXIMIZE)

# Add constraints
# Total number of trucks constraint
model.addConstr(cp.quicksum(x[(i, j)] for i in regions for j in truck_types) <= total_trucks, name="TotalTrucks")

# Budget constraint for leasing trucks
model.addConstr(cp.quicksum(costs[i]['leased'] * x[(i, 'leased')] for i in regions) <= 25000, name="LeaseBudget")

# Minimum truck requirements for each region
for i in regions:
    model.addConstr(cp.quicksum(x[(i, j)] for j in truck_types) >= 3, name=f"MinTrucks_{i}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized average net profit per truck: {:.2f}".format(model.objval))
    print("Optimal truck allocation:")
    for i in regions:
        for j in truck_types:
            if x[(i, j)].x > 0:
                print(f"Region {i}: {j} trucks = {x[(i, j)].x}")
else:
    print("No optimal solution found.")
```

