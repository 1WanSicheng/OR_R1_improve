model.addConstr(x2 <= 10, name="RadioAdConstraint")  # Maximum number of radio commercials
model.addConstr(x3 <= 7, name="NewspaperAdConstraint")  # Maximum number of newspaper ads
model.addConstr(x1 + x2 + x3 <= 15, name="TotalAdConstraint")  # Maximum total number of commercials and/or ads

# Set the objective function to maximize exposure
model.setObjective(20000*x1 + 2000*x2 + 9000*x3, sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized exposure: {:.0f} people".format(model.objval))
    print("Optimal advertising strategy:")
    print("Number of television commercials: {:.0f}".format(x1.x))
    print("Number of radio commercials: {:.0f}".format(x2.x))
    print("Number of newspaper ads: {:.0f}".format(x3.x))
else:
    print("No optimal solution found.")
```

