model.addConstr(x1 >= 8, name="HorseTripsConstraint")  # Number of trips using horses must be at least 8
model.addConstr(x2 + x3 <= 1, name="BicycleOrCartConstraint")  # Only choose one of bicycles or hand carts

# Set the objective function to minimize total pollution
model.setObjective(80*x1 + 0*x2 + 0*x3, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total pollution: {:.2f}".format(model.objval))
    print("Number of trips using horses: {:.0f}".format(x1.x))
