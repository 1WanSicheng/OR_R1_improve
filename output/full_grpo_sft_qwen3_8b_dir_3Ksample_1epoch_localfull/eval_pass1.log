```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("BudgetAllocation")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Budget allocated to department X
