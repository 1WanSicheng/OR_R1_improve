    (6, 0): 7, (6, 1): 9, (6, 2): 17, (6, 3): 18, (6, 4): 16, (6, 5): 8
}

# Add decision variables
f = {(i, j): model.addVar(lb=0, name=f"f_{i}_{j}") for i in cities for j in cities if i != j}

# Objective function: Maximize the amount of goods transported from the distribution hub to the final destination
model.setObjective(cp.quicksum(f[(0, j)] for j in cities if j != 0), sense=COPT.MAXIMIZE)

# Constraints
# Flow conservation
for i in cities:
    if i == 0:
        model.addConstr(cp.quicksum(f[(0, j)] for j in cities if j != 0) == cp.quicksum(f[(j, 0)] for j in cities if j != 0), name=f"FlowConservation_{i}")
    elif i == 6:
        model.addConstr(cp.quicksum(f[(i, j)] for j in cities if j != 6) == cp.quicksum(f[(0, j)] for j in cities if j != 0), name=f"FlowConservation_{i}")
    else:
        model.addConstr(cp.quicksum(f[(i, j)] for j in cities if j != i) == cp.quicksum(f[(j, i)] for j in cities if j != i), name=f"FlowConservation_{i}")

# Route capacity constraints
for i in cities:
    for j in cities:
        if i != j and (i, j) in capacities:
            model.addConstr(f[(i, j)] <= capacities[(i, j)], name=f"CapacityConstraint_{i}_{j}")

# Solve the model
