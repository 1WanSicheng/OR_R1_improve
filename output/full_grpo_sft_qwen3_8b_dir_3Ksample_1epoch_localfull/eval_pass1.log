## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("GlueProductionOptimization")

# Production rates
production_rates = {
    (1, 1): 20, (1, 2): 30, (1, 3): 40,
    (2, 1): 50, (2, 2): 35, (2, 3): 45,
    (3, 1): 30, (3, 2): 40, (3, 3): 50,
    (4, 1): 40, (4, 2): 45, (4, 3): 50,
    (5, 1): 25, (5, 2): 35, (5, 3): 45
}

# Demand
demand = {1: 120, 2: 150, 3: 200}

# Add decision variables
x = {(i, j): model.addVar(lb=0, name=f"x_{i}_{j}") for i in range(1, 6) for j in range(1, 4)}

# Objective function: Minimize the time required to meet the weekly demand
model.setObjective(cp.quicksum(demand[j] / cp.quicksum(production_rates[i, j] * x[i, j] for i in range(1, 6)) for j in range(1, 4)), sense=COPT.MINIMIZE)

# Constraints
# Worker allocation constraints
for j in range(1, 4):
    model.addConstr(cp.quicksum(x[i, j] for i in range(1, 6)) <= 20, name=f"WorkerAllocation_{j}")

# Total worker constraint
model.addConstr(cp.quicksum(x[i, j] for i in range(1, 6) for j in range(1, 4)) <= 80, name="TotalWorkers")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum time required to meet the weekly demand: {:.2f} hours".format(model.objval))
    for i in range(1, 6):
        for j in range(1, 4):
            print(f"Number of workers assigned to production line {i} for glue {j}: {x[i, j].x}")
else:
    print("No optimal solution found.")
```

