```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("WorkerDietOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="x")  # Number of hamburgers
y = model.addVar(lb=0, vtype=COPT.CONTINUOUS, name="y")  # Number of chicken wraps

# Add constraints
model.addConstr(800*x + 450*y >= 2200, name="CalorieRequirement")  # Calorie requirement
model.addConstr(19*x + 12*y >= 50, name="ProteinRequirement")  # Protein requirement
model.addConstr(20*x + 10*y >= 70, name="CarbohydrateRequirement")  # Carbohydrate requirement

# Set the objective function to minimize total cost
model.setObjective(6.5*x + 4*y, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.2f} dollars".format(model.objval))
    print("Optimal quantities:")
    print("Number of hamburgers: {:.2f}".format(x.x))
    print("Number of chicken wraps: {:.2f}".format(y.x))
else:
    print("No optimal solution found.")
```

This script first creates a COPT environment and model. Then, it adds two decision variables, `x` and `y`, representing the quantities of hamburgers and chicken wraps, respectively.

