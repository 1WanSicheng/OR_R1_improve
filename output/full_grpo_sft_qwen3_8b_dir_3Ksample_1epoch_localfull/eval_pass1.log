    print(f"Shortest distance from {start_node} to {end_node}: {round(model.objval)} meters")
    print(f"Shortest path: {start_node} -> {' -> '.join([v for v in nodes if v != start_node and v != end_node and distances[v].x > 0])} -> {end_node}")
else:
    print("No optimal solution found.")
```

