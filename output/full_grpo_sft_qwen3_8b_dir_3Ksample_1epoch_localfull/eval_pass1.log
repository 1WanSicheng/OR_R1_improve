model.addConstr(30*x + 22*y <= 940, name="PowerLimit")  # Electricity usage limit
model.addConstr(y >= 5, name="LooseSkiLiftDemand")  # Requirement for at least five loosely-seated ski lifts

# Set the objective function to minimize the total number of ski lifts
