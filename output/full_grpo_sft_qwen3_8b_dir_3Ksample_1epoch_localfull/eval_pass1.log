model.addConstr(x2 <= 10, name="RadioTimeConstraint")  # Radio commercial time constraint
model.addConstr(x3 <= 7, name="NewspaperSpaceConstraint")  # Newspaper ad space constraint
model.addConstr(x1 + x2 + x3 <= 15, name="ResourceConstraint")  # Resource constraint

# Set the objective function
model.setObjective(20000*x1 + 2000*x2 + 9000*x3, sense=COPT.MAXIMIZE)  # Maximize exposure people

# Solve the model
