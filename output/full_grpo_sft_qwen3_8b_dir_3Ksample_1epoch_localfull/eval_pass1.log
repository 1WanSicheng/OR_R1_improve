model.addConstr(cp.quicksum(water[i] * x[i] for i in crops) <= 100000, name="WaterSupply")

# Labor cost constraint
model.addConstr(cp.quicksum(labor_cost[i] * x[i] for i in crops) <= 10000, name="LaborCost")

# Land area constraint
model.addConstr(cp.quicksum(x[i] for i in crops) <= 200, name="LandArea")

# Minimum land area constraint
model.addConstr(cp.quicksum(x[i] for i in crops) >= 50, name="MinLandArea")

# Solve the model
model.solve()

# Output the results
