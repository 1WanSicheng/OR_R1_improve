# Cargo capacity
capacity = {'A': 10, 'B': 15, 'C': 20, 'D': 25, 'E': 30}

# Add decision variables
x = {i: model.addVar(vtype=COPT.INTEGER, name=f"x_{i}") for i in truck_types}

# Objective function: Minimize total cost per ton-kilometer
objective = cp.quicksum((fuel_cost[i] * 2000 + maintenance_cost[i]) / capacity[i] * x[i] for i in truck_types)
model.setObjective(objective, sense=COPT.MINIMIZE)

# Constraints
# Budget constraint
model.addConstr(cp.quicksum(maintenance_cost[i] * x[i] for i in truck_types) <= 100000, name="BudgetConstraint")

# Cargo transportation requirement
model.addConstr(cp.quicksum(capacity[i] * x[i] for i in truck_types) >= 500, name="TransportationRequirement")

# Truck quantity constraint
model.addConstr(cp.quicksum(x[i] for i in truck_types) <= 30, name="TruckQuantityConstraint")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost per ton-kilometer: {:.2f}".format(model.objval))
    print("Optimal truck deployment:")
    for i in truck_types:
        print(f"Truck {i}: {x[i].x} trucks")
else:
    print("No optimal solution found.")
```

