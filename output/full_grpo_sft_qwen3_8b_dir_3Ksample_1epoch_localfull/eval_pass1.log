    print("Number of ounces of Regular Brute produced: {:.2f}".format(x2.x))
    print("Number of ounces of Regular Chanelle produced: {:.2f}".format(x3.x))
    print("Number of ounces of Luxury Brute produced: {:.2f}".format(x4.x))
    print("Number of ounces of Luxury Chanelle produced: {:.2f}".format(x5.x))
else:
    print("No optimal solution found.")
```

