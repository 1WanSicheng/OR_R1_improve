```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("FurnitureFactoryOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of bedside tables
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of bookcases

