import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("TravelingSalesmanProblem")

# Define the number of cities
n = 4

# Define the travel costs
costs = [
    [0, 61, 17, 81],
    [61, 0, 40, 52],
    [17, 40, 0, 23],
    [81, 52, 23, 0]
]

# Add decision variables
x = [[model.addVar(vtype=COPT.BINARY, name=f"x_{i}_{j}") for j in range(n)] for i in range(n)]

# Objective function: Minimize total travel cost
model.setObjective(cp.quicksum(costs[i][j] * x[i][j] for i in range(n) for j in range(n) if i != j), sense=COPT.MINIMIZE)

# Constraints
# Each city can only be visited once
for i in range(n):
    model.addConstr(cp.quicksum(x[i][j] for j in range(n) if i != j) == 1, name=f"VisitOnce_{i}")

# Each city can only be left once
for j in range(n):
    model.addConstr(cp.quicksum(x[i][j] for i in range(n) if i != j) == 1, name=f"LeaveOnce_{j}")

# Subtour elimination constraints (Miller-Tucker-Zemlin constraints)
u = [model.addVar(lb=1, ub=n, vtype=COPT.INTEGER, name=f"u_{i}") for i in range(n)]
for i in range(1, n):
    for j in range(i+1, n):
        model.addConstr(u[i] - u[j] + n * x[i][j] <= n - 1, name=f"SubtourElimination_{i}_{j}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total travel cost: {:.2f}".format(model.objval))
    print("Optimal route:")
    route = [0]
    current_city = 0
    while len(route) < n:
        for j in range(n):
            if x[current_city][j].x > 0.5:
                route.append(j)
                current_city = j
                break
    route.append(route[0])
    for i in range(len(route)-1):
        print(f"City {route[i]} -> City {route[i+1]}")
else:
    print("No optimal solution found.")
```

This script first defines the number of cities and the travel costs. Then, it creates a COPT environment and model, and adds binary decision variables `x[i][j]` to represent whether the salesperson travels from city `i` to city `j`.

The objective function is to minimize the total travel cost, which is the sum of the travel costs multiplied by the corresponding decision variables.

The constraints include:
1. Each city can only be visited once.
2. Each city can only be left once.
3. Subtour elimination constraints, which use the Miller-Tucker-Zemlin (MTZ) constraints to ensure that the solution does not contain any subtours.

Finally, the script solves the model and outputs the minimum total travel cost and the optimal route.

Note that this script assumes you have installed the `coptpy` library and have a valid COPT solver available. If you haven't installed it yet, you may need to install the library and solver before running this script.
