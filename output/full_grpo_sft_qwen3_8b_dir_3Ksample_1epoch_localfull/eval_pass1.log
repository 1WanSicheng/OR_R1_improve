model.addConstr(x['X'] >= 10, name="MinTruckXConstraint")
model.addConstr(x['Y'] >= 15, name="MinTruckYConstraint")

# Budget constraint for route optimization software
model.addConstr(cp.quicksum(y[i] for i in goods) <= 10000, name="OptimizationBudgetConstraint")

# Cost savings constraint
model.addConstr(cp.quicksum(cost_reductions[i] * y[i] for i in goods) >= 
                cp.quicksum(initial_costs[i] * x[i] for i in goods), 
                name="CostSavingConstraint")

# Solve the model
model.solve()

# Output the results
