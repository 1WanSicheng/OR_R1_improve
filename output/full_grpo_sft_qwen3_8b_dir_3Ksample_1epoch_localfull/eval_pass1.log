marketing_cost = {'AppX': 20000, 'AppY': 30000, 'AppZ': 40000, 'AppW': 25000, 'AppV': 35000}

# Add decision variables
x = {i: model.addVar(vtype=COPT.INTEGER, name=f"x_{i}") for i in products}

