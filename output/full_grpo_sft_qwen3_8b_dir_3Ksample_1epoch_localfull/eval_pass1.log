model.addConstr(cp.quicksum(fertilizers[i]['N'] * x[i] for i in fertilizers) >= 10, name="Nitrogen_LB")
model.addConstr(cp.quicksum(fertilizers[i]['N'] * x[i] for i in fertilizers) <= 10.5, name="Nitrogen_UB")

# Phosphorus content constraint
model.addConstr(cp.quicksum(fertilizers[i]['P'] * x[i] for i in fertilizers) >= 8, name="Phosphorus_LB")
model.addConstr(cp.quicksum(fertilizers[i]['P'] * x[i] for i in fertilizers) <= 8.5, name="Phosphorus_UB")

# Potash content constraint
