    print("Optimal employee allocation:")
    print("Department X: {:.0f} employees".format(x_X.x))
    print("Department Y: {:.0f} employees".format(x_Y.x))
    print("Department Z: {:.0f} employees".format(x_Z.x))
else:
    print("No optimal solution found.")
```

