## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve this problem:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("LogisticsOptimization")

# Define vehicle types and related parameters
vehicles = ['TruckX', 'TruckY', 'TruckZ']
initial_revenue = {'TruckX': 1000, 'TruckY': 1500, 'TruckZ': 2000}
upgrade_revenue = {'TruckX': 100, 'TruckY': 150, 'TruckZ': 200}
upgrade_cost = {'TruckX': 500, 'TruckY': 500, 'TruckZ': 500}
operational_cost = {'TruckX': 500, 'TruckY': 750, 'TruckZ': 1000}

# Add decision variables
x = {i: model.addVar(lb=0, name=f"x_{i}") for i in vehicles}
u = {i: model.addVar(lb=0, name=f"u_{i}") for i in vehicles}

# Set the objective function
model.setObjective(cp.quicksum((initial_revenue[i] + upgrade_revenue[i] * u[i] / upgrade_cost[i]) * x[i] - operational_cost[i] * x[i] for i in vehicles), sense=COPT.MAXIMIZE)

# Add constraints
# Budget constraint
model.addConstr(cp.quicksum(upgrade_cost[i] * u[i] + operational_cost[i] * x[i] for i in vehicles) <= 100000, name="BudgetConstraint")

# Total trip quantity constraint
model.addConstr(cp.quicksum(x[i] for i in vehicles) <= 200, name="TotalTripsConstraint")

# Maintenance schedule constraints
model.addConstr(x['TruckX'] <= 50, name="MaintenanceConstraintX")
model.addConstr(x['TruckY'] <= 70, name="MaintenanceConstraintY")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total revenue: {:.2f}".format(model.objval))
    for i in vehicles:
        print(f"Number of trips for {i}: {x[i].x:.0f}, Upgrade investment: {u[i].x:.2f}")
else:
    print("No optimal solution found.")
```

