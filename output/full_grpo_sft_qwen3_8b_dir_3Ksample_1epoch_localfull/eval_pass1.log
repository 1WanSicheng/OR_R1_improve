model.addConstr(2*x1 - 0.5*x3 >= 300, name="BalanceConstraintX1X3")
model.addConstr(x1 + x2 - x4 <= 400, name="BalanceConstraintX1X2X4")

# Set the objective function
model.setObjective(2*x1 + 3*x2 + 4*x3 + 5*x4, sense=COPT.MINIMIZE)

