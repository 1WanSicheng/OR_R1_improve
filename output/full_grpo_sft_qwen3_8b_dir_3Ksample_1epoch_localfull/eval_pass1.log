from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a COPT model
model = env.createModel("JamShippingOptimization")

# Add decision variables
x = model.addVar(lb=0, vtype=COPT.INTEGER, name="x")  # Number of small jars
y = model.addVar(lb=0, vtype=COPT.INTEGER, name="y")  # Number of large jars

# Add constraints
model.addConstr(50*x + 200*y >= 100000, name="ShippingRequirement")  # Requirement of shipping at least 100000 ml of jam
model.addConstr(y <= x, name="LargeJarLimit")  # Limit on the number of large jars

# Set the objective function
model.setObjective(x + y, sense=COPT.MINIMIZE)  # Minimize the total number of jars

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum number of jars: {:.0f}".format(model.objval))
    print("Number of small jars: {:.0f}".format(x.x))
    print("Number of large jars: {:.0f}".format(y.x))
else:
    print("No optimal solution found.")
```

