model.addConstr(y1 >= x1, name="SetupCostConstraint1")  # Setup cost constraint for product 1
model.addConstr(y2 >= x2, name="SetupCostConstraint2")  # Setup cost constraint for product 2

# Set the objective function
model.setObjective(2*x1 + 5*x2 - 10*y1 - 20*y2, sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total profit: {:.2f}".format(model.objval))
    print("Optimal production quantities:")
    print("Product 1: {:.0f} units".format(x1.x))
    print("Product 2: {:.0f} units".format(x2.x))
else:
    print("No optimal solution found.")
