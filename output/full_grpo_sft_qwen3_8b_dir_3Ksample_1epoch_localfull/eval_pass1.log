model.addConstr(x - y <= 50, name="StaffExpertise1")  # Staff expertise constraint
model.addConstr(y - x <= 50, name="StaffExpertise2")  # Staff expertise constraint

# Set the objective function
model.setObjective(10000*x + 15000*y, sense=COPT.MINIMIZE)  # Minimize total cost

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: ${:.2f}".format(model.objval))
    print("Optimal resource allocation:")
    print("Task X: {:.0f} units".format(x.x))
    print("Task Y: {:.0f} units".format(y.x))
else:
    print("No optimal solution found.")
```

