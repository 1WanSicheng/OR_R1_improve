model.addConstr(z - x <= 3, name="IndustrialResidentialConstraint1")  # Difference between industrial and residential properties should not exceed three
model.addConstr(x - z <= 3, name="IndustrialResidentialConstraint2")  # Difference between industrial and residential properties should not exceed three

# Set the objective function to minimize total cost
