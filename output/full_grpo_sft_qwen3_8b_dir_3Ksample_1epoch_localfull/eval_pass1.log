    print("Maximized profit: {:.2f}".format(model.objval))
    print("Optimal inventory quantities:")
    print("Phones: {:.0f}".format(x.x))
    print("Laptops: {:.0f}".format(y.x))
else:
    print("No optimal solution found.")
```

