x2 = model.addVar(lb=0, ub=20, vtype=COPT.INTEGER, name="x2")  # Number of workers assigned to production line 2
x3 = model.addVar(lb=0, ub=20, vtype=COPT.INTEGER, name="x3")  # Number of workers assigned to production line 3

