env = cp.Envr()

# Create a model
model = env.createModel("BakeryOptimization")

# Add decision variables
Tc = model.addVar(lb=0, name="Tc")  # Baking time for chocolate cake
Tv = model.addVar(lb=0, name="Tv")  # Baking time for vanilla cake
Ts = model.addVar(lb=0, name="Ts")  # Baking time for strawberry cake
Tl = model.addVar(lb=0, name="Tl")  # Baking time for lemon cake

# Add constraints
model.addConstr(Tc + Tv + Ts + Tl <= 24, name="TotalBakingTime")  # Total baking time does not exceed 24 hours
model.addConstr(Tc >= 1, name="ChocolateMinBake")  # Chocolate cake is baked at least once
model.addConstr(Tv >= 1, name="VanillaMinBake")  # Vanilla cake is baked at least once
model.addConstr(Ts >= 1, name="StrawberryMinBake")  # Strawberry cake is baked at least once
model.addConstr(Tl >= 1, name="LemonMinBake")  # Lemon cake is baked at least once
model.addConstr(Tc <= 10, name="ChocolateMaxBake")  # Chocolate cake baking time does not exceed 10 hours
model.addConstr(Tv <= 8, name="VanillaMaxBake")  # Vanilla cake baking time does not exceed 8 hours
model.addConstr(Ts <= 6, name="StrawberryMaxBake")  # Strawberry cake baking time does not exceed 6 hours
model.addConstr(Tl <= 4, name="LemonMaxBake")  # Lemon cake baking time does not exceed 4 hours

# Set the objective function
model.setObjective(5*Tc**2 + 4*Tv**2 + 3*Ts**2 + 2*Tl**2, sense=COPT.MAXIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Maximized total revenue: {:.2f}".format(model.objval))
    print("Optimal baking time:")
    print("Chocolate cake: {:.2f} hours".format(Tc.x))
    print("Vanilla cake: {:.2f} hours".format(Tv.x))
    print("Strawberry cake: {:.2f} hours".format(Ts.x))
    print("Lemon cake: {:.2f} hours".format(Tl.x))
else:
    print("No optimal solution found.")
```

