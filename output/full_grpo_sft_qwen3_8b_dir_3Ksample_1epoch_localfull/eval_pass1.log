model.addConstr(2*x + z <= 15, name="ResourceAllocationConstraint")  # Sum of twice the effort put into Project X plus the effort in Project Z should not exceed 15 units
model.addConstr(y - z >= 5, name="PriorityConstraint")  # Effort put into project Y minus that in project Z must be at least 5 units

# Set the objective function to minimize total resource requirement
model.setObjective(2*x + 3*y + z, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total resource requirement: {:.0f} units".format(model.objval))
    print("Optimal effort allocation:")
    print("Project X: {:.0f} units".format(x.x))
    print("Project Y: {:.0f} units".format(y.x))
    print("Project Z: {:.0f} units".format(z.x))
else:
    print("No optimal solution found.")
```

