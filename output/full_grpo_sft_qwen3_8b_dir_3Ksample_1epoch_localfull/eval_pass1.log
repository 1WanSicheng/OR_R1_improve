model.addConstr(4*x1 + 17*x2 + 28*x3 + 27*x4 >= 120, name="CarbohydrateRequirement")
model.addConstr(218*x1 + 290*x2 + 298*x3 + 158*x4 >= 2435, name="CalorieRequirement")

# Set the objective function
model.setObjective(3*x1 + 6*x2 + 1*x3 + 10*x4, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

