# Number of trips constraint
model.addConstr(cp.quicksum(x[i] + y[i] for i in goods) <= 100, name="TripConstraint")

# Budget constraint
model.addConstr(cp.quicksum(500 * x[i] + 100 * y[i] for i in goods) <= 3000, name="BudgetConstraint")

# Solve the model
