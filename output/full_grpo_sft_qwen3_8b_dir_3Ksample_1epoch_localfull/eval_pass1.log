## Python Code Solution Using `coptpy`:
Below is a Python script using the `coptpy` library to solve the production planning problem for Sailco Corporation:

```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("SailcoProductionPlanning")

# Define the demand for each quarter
demand = [40, 60, 75, 25]

# Define the initial inventory
initial_inventory = 10

# Add decision variables
p = [model.addVar(lb=0, name=f"p_{t}") for t in range(4)]  # Number of sailboats produced using regular-time labor
o = [model.addVar(lb=0, name=f"o_{t}") for t in range(4)]  # Number of sailboats produced using overtime labor
i = [model.addVar(lb=0, name=f"i_{t}") for t in range(4)]  # Inventory level at the end of each quarter

# Set the objective function
model.setObjective(cp.quicksum(400*p[t] + 450*o[t] + 20*i[t] for t in range(4)), sense=COPT.MINIMIZE)

# Add constraints
# Demand satisfaction for each quarter
for t in range(4):
    if t == 0:
        model.addConstr(initial_inventory + p[t] + o[t] - i[t] == demand[t], name=f"Demand_{t}")
    else:
        model.addConstr(i[t-1] + p[t] + o[t] - i[t] == demand[t], name=f"Demand_{t}")

# Production capacity constraints
for t in range(4):
    model.addConstr(p[t] <= 40, name=f"RegularTimeCapacity_{t}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum sum of production and inventory costs: {:.2f}".format(model.objval))
    print("Optimal production schedule:")
    for t in range(4):
        print(f"Quarter {t+1}: Regular-time production = {p[t].x:.2f}, Overtime production = {o[t].x:.2f}, Inventory = {i[t].x:.2f}")
else:
    print("No optimal solution found.")
```

