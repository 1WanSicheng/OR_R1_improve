model.addConstr(x3 + x4 <= 50, name="BudgetConstraint2")
model.addConstr(x3 >= 2*(x1 - x3), name="StrategicConstraint1")
model.addConstr(x4 >= 0.75*(x2 - x4), name="StrategicConstraint2")
model.addConstr(x3 + x4 - x1 - x2 >= 30, name="ResourceRebalancing")

# Set the objective function
model.setObjective(500*x1 + 600*x2 + 800*x3 + 700*x4, sense=COPT.MINIMIZE)

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.0f}".format(model.objval))
    print("Optimal resource allocation:")
    print("x1 = {:.0f}".format(x1.x))
    print("x2 = {:.0f}".format(x2.x))
    print("x3 = {:.0f}".format(x3.x))
    print("x4 = {:.0f}".format(x4.x))
else:
    print("No optimal solution found.")
```

