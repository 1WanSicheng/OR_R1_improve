```python
import coptpy as cp
from coptpy import COPT

# Create a COPT environment
env = cp.Envr()

# Create a model
model = env.createModel("BusDriverAllocation")

# Define the number of time periods
num_shifts = 6

# Define the number requirements for each time period
demand = [60, 70, 60, 50, 20, 30]

# Add decision variables
x = [model.addVar(vtype=COPT.INTEGER, name=f"x_{i+1}") for i in range(num_shifts)]

# Set the objective function
model.setObjective(cp.quicksum(x[i] for i in range(num_shifts)), sense=COPT.MINIMIZE)

# Add constraints
for i in range(num_shifts):
    model.addConstr(cp.quicksum(x[j] for j in range(i, num_shifts)) >= demand[i], name=f"Demand_{i+1}")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum number of drivers and crew members:", model.objval)
    print("Number of drivers and crew members to be equipped for each time period:")
    for i in range(num_shifts):
        print(f"Time period {i+1}: {x[i].x}")
else:
    print("No optimal solution found.")
```

