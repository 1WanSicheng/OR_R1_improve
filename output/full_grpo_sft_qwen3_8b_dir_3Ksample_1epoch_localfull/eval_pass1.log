model.setObjective(500 * 7 * (x_11 + x_12 + x_13) + 900 * 7 * (x_21 + x_22 + x_23) + 1000 + 2000, sense=COPT.MINIMIZE)

# Add constraints
# Production requirements
model.addConstr(20 * x_11 + 50 * x_21 >= 120, name="Demand1")
model.addConstr(30 * x_12 + 35 * x_22 >= 150, name="Demand2")
model.addConstr(40 * x_13 + 45 * x_23 >= 200, name="Demand3")

# Worker constraints
model.addConstr(x_11 <= 7, name="Worker1")
model.addConstr(x_12 <= 7, name="Worker2")
model.addConstr(x_13 <= 7, name="Worker3")
model.addConstr(x_21 <= 7, name="Worker4")
model.addConstr(x_22 <= 7, name="Worker5")
model.addConstr(x_23 <= 7, name="Worker6")

# Solve the model
model.solve()

# Output the results
if model.status == COPT.OPTIMAL:
    print("Minimum total cost: {:.2f}".format(model.objval))
    print("Optimal production plan:")
